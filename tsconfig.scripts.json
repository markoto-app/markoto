{
  // Type-checks scripts/** and the fixture scripts. Bun globals/types come from the root @types/bun.
  "extends": "./.nuxt/tsconfig.app.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    "noEmit": true
  },
  "include": [".nuxt/nuxt.d.ts", "shared/**/*.d.ts", "app/types/*.d.ts", "scripts/**/*", "tests/fixtures/**/*.ts"]
}
