# markoto: environment template (development + hosted deploys).
# GENERATED by `bun scripts/env-gen.ts` from the registry in shared/env/, edit the registry, not this file.
#
# Self-hosting? Don't copy this file: run ./install.sh, which writes a
# complete .env for deploy/compose/compose.selfhost.yml (docs/SELF-HOSTING.md).
#
# Daily dev: `make dev` (infra only, deploy/compose/compose.dev.yml) +
# `bun run dev` on the host; the values below match deploy/compose/compose.dev.yml.
# `make setup` copies this file to .env and generates every empty secret.
#
# Uncommented lines are the ones a dev stack needs; commented ones show the
# default. Every variable is described in docs/reference/configuration.md;
# the app, sync server and renderer validate their set at boot.

# ─── Instance ────────────────────────────────────────────────────────────────
# Public address and runtime mode of this instance.
# `production` turns on production checks (required NUXT_SITE_URL, Postgres TLS, Secure cookies); the images set it.
# NODE_ENV=
# Minimum level the app, the sync server and the renderer log (`debug`, `info`, `warn`, `error`). Production writes one JSON object per line.
# LOG_LEVEL=info
# Public origin of this instance (https://docs.example.org). Email links are built only from it, never from the request Host.
# NUXT_SITE_URL=
# Origin named by canonical / og:url / JSON-LD / sitemap. Empty = NUXT_SITE_URL (staging renders https://markoto.app).
# NUXT_CANONICAL_SITE_URL=
# Origin the /docs pages' canonical links point to off the marketing site. Unset = https://markoto.app; set but empty = this instance.
# NUXT_DOCS_CANONICAL_BASE=
# false keeps the instance out of search engines (robots.txt Disallow: / + X-Robots-Tag: noindex everywhere). Staging renders false.
# NUXT_SITE_INDEXABLE=true
# "This instance is markoto.app": product tour at /, sitemap, JSON-LD, hosted-only marketing pages.
# NUXT_MARKETING_SITE_ENABLED=false
# Reverse proxies in front of the app and sync server; the client IP is the N-th X-Forwarded-For entry from the right (0 = socket address).
# NUXT_TRUSTED_PROXY_HOPS=1
# Comma-separated emails promoted to admin at their next sign-in with a VERIFIED address (case-insensitive).
# NUXT_ADMIN_USER_EMAILS=

# ─── App server ──────────────────────────────────────────────────────────────
# Bun HTTP server of the app container (server/runtime/bunEntry.ts reads these before Nitro starts).
# Port the app listens on (NITRO_PORT wins when set).
# PORT=3000
# Overrides PORT for the app server.
# NITRO_PORT=
# Address the app server binds (HOST is read as a fallback). Default: all interfaces.
# NITRO_HOST=
# Fallback for NITRO_HOST.
# HOST=
# Seconds an HTTP connection may stay silent, including while a slow request (PDF render, import) is still working. Must stay above the 100 s PDF render deadline.
# NITRO_BUN_IDLE_TIMEOUT=120
# Largest request body on any route, enforced by Bun before buffering (51 MiB = a 50 MB import plus form framing).
# NITRO_MAX_REQUEST_BODY_BYTES=53477376
# Directory the boot migration reads (the image ships ./drizzle).
# DRIZZLE_MIGRATIONS_DIR=./drizzle
# Queries slower than this (ms) raise a warning-level Sentry event.
# NUXT_DB_SLOW_QUERY_MS=200

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Signing and service-to-service secrets (≥ 32 chars each; `openssl rand -hex 32`). *_PREVIOUS only during a rotation (docs/SELF-HOSTING.md, rotating secrets).
# Seals the session cookie (nuxt-auth-utils; runtimeConfig.session.password).
NUXT_SESSION_PASSWORD=
# Signs the document tokens the sync server verifies.
NUXT_JWT_SECRET=
# Previous NUXT_JWT_SECRET, still accepted by verifiers during a rotation.
NUXT_JWT_SECRET_PREVIOUS=
# Shared secret of the app ↔ sync ↔ renderer internal HTTP calls and render tokens.
NUXT_INTERNAL_API_SECRET=
# Previous NUXT_INTERNAL_API_SECRET, still accepted during a rotation.
NUXT_INTERNAL_API_SECRET_PREVIOUS=
# Encrypts the secrets the app stores in Postgres (LiteLLM virtual keys, users' own AI provider keys, workspace SSO client secrets). Losing or replacing it makes them unreadable: rotate through NUXT_ENCRYPTION_KEY_PREVIOUS.
NUXT_ENCRYPTION_KEY=
# Previous NUXT_ENCRYPTION_KEY, still used to decrypt during a rotation (then `bun run secrets:reencrypt`).
NUXT_ENCRYPTION_KEY_PREVIOUS=
# Signs live-dictation WebSocket tokens; empty = NUXT_JWT_SECRET.
NUXT_AI_DICTATE_JWT_SECRET=

# ─── Sign-in ─────────────────────────────────────────────────────────────────
# Login is optional: with no provider configured the instance is anonymous-only. Each provider is all-or-nothing (boot fails on a half pair).
# GitHub OAuth app client id (runtimeConfig.oauth.github, read by nuxt-auth-utils).
NUXT_OAUTH_GITHUB_CLIENT_ID=
# GitHub OAuth app client secret.
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# Explicit GitHub callback URL (<public URL>/auth/github); empty = derived by nuxt-auth-utils.
# NUXT_OAUTH_GITHUB_REDIRECT_URL=
# Google OAuth client id (runtimeConfig.oauth.google).
NUXT_OAUTH_GOOGLE_CLIENT_ID=
# Google OAuth client secret.
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Explicit Google callback URL (<public URL>/auth/google); empty = derived by nuxt-auth-utils.
# NUXT_OAUTH_GOOGLE_REDIRECT_URL=
# OpenID Connect issuer (exact `issuer` of the IdP's discovery document). https only, except NODE_ENV=development / TEST_MODE.
# NUXT_OAUTH_OIDC_ISSUER=
# OIDC client id (confidential client, auth-code flow + PKCE).
# NUXT_OAUTH_OIDC_CLIENT_ID=
# OIDC client secret.
# NUXT_OAUTH_OIDC_CLIENT_SECRET=
# Sign-in button label ("Continue with <name>", max 40 chars); empty = "single sign-on".
# NUXT_OAUTH_OIDC_NAME=
# Space- or comma-separated scopes (openid is always added).
# NUXT_OAUTH_OIDC_SCOPES=openid email profile
# Explicit OIDC redirect URI; default <NUXT_SITE_URL>/auth/oidc (never the request Host).
# NUXT_OAUTH_OIDC_REDIRECT_URL=
# Let workspace SSO connections (OIDC/SAML metadata) point at private-network IdPs. Self-host only.
# NUXT_SSO_ALLOW_PRIVATE_URLS=false

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Connection parts (shared/utils/runtime/connectionStrings.ts builds the URL). Dev: the values below match deploy/compose/compose.dev.yml; the containerised stacks set the host themselves.
# Role the app and sync server connect as (the compose files substitute POSTGRES_APP_USER when set). Also the admin role of db-init and backups.
POSTGRES_USER=ypad
# Password of POSTGRES_USER.
POSTGRES_PASSWORD=devpassword
# Database host (compose: `postgres`, or the managed cluster endpoint).
POSTGRES_HOST=localhost
# Database port.
POSTGRES_PORT=5432
# Database of the app (LiteLLM uses its own `litellm` database).
POSTGRES_DB=ypad
# `disable` turns TLS to Postgres off (otherwise on in production). No other value is accepted.
# PGSSL=
# Path of a CA PEM the Postgres server certificate is verified against (default: system CA bundle). Unreadable = boot fails.
# PGSSLROOTCERT=
# libpq sslmode for LiteLLM's DATABASE_URL, db-init and the backup sidecar (managed Postgres: require).
# POSTGRES_SSLMODE=
# Least-privilege role the app and sync server connect as (db-init creates it). Empty = POSTGRES_USER.
# POSTGRES_APP_USER=
# Password of POSTGRES_APP_USER.
# POSTGRES_APP_PASSWORD=
# Role LiteLLM connects as (owner of the litellm database only). Empty = POSTGRES_USER.
# POSTGRES_LITELLM_USER=
# Password of POSTGRES_LITELLM_USER.
# POSTGRES_LITELLM_PASSWORD=

# ─── Valkey ──────────────────────────────────────────────────────────────────
# Rate limits, locks and the sync server's per-document state.
# Valkey host (compose: `valkey`).
VALKEY_HOST=localhost
# Valkey port.
VALKEY_PORT=6379
# Valkey password (empty = no auth; the containerised stacks require one).
VALKEY_PASSWORD=devpassword
# Logical database index.
VALKEY_DB=0
# TLS to Valkey (rediss://), for a managed or remote Valkey.
# VALKEY_TLS_ENABLED=false
# CA PEM for a provider with a private CA (default: system CA store).
# VALKEY_TLS_CA_PATH=

# ─── Object storage (S3) ─────────────────────────────────────────────────────
# Image uploads, knowledge originals and render artefacts. The renderer reads the same values without the NUXT_ prefix.
# S3 API endpoint the app (and renderer) talk to.
NUXT_S3_ENDPOINT=http://localhost:8333
# Base URL browsers use for presigned URLs when it differs from NUXT_S3_ENDPOINT (self-host: the public origin). SigV4 signs the host.
# NUXT_S3_PUBLIC_ENDPOINT=
# S3 access key.
NUXT_S3_ACCESS_KEY=ypad-access-key
# S3 secret key.
NUXT_S3_SECRET_KEY=ypad-secret-key
# Bucket name.
NUXT_S3_BUCKET=ypad
# Server-side encryption header on render artefacts and backups; `none` (or set but empty) for backends without SSE-S3 (SeaweedFS).
# S3_SSE=AES256
# Days a confirmed image must stay unreferenced before it is deleted (0 = image GC off).
# NUXT_IMAGE_GC_RETENTION_DAYS=30

# ─── Import converter (markitdown) ───────────────────────────────────────────
# Imports, knowledge uploads and design extraction. The converter refuses requests without the shared secret.
# Internal URL of the markitdown service.
NUXT_MARKITDOWN_URL=http://localhost:8080
# Shared secret the app sends to markitdown.
NUXT_MARKITDOWN_API_SECRET=
# Wall-clock budget of one conversion (markitdown-server/server.py).
# MARKITDOWN_TIMEOUT_SECONDS=
# Memory cap of the conversion child process.
# MARKITDOWN_CHILD_MEMORY_MB=
# Largest inflated size of an uploaded archive (default 200).
# MARKITDOWN_MAX_UNCOMPRESSED_MB=
# Most entries in an uploaded archive (default 10000).
# MARKITDOWN_MAX_ARCHIVE_ENTRIES=
# Highest compression ratio of an archive (default 100).
# MARKITDOWN_MAX_COMPRESSION_RATIO=
# Budget of the archive inflate check (default 20).
# MARKITDOWN_ARCHIVE_CHECK_TIMEOUT_SECONDS=

# ─── Sync server (Hocuspocus) ────────────────────────────────────────────────
# Real-time collaboration. NUXT_* values are read by the app; the rest by the sync server.
# Internal HTTP URL the app calls the sync server on.
NUXT_SYNC_INTERNAL_URL=http://localhost:4001
# WebSocket URL browsers connect to (runtimeConfig.public.syncUrl).
NUXT_PUBLIC_SYNC_URL=ws://localhost:4001
# Largest WebSocket frame (closed with 1009 above it).
# SYNC_MAX_MESSAGE_BYTES=17825792
# Largest single Y.js update.
# SYNC_MAX_UPDATE_BYTES=16777216
# Largest encoded document after an update (deletions always pass).
# SYNC_MAX_DOCUMENT_BYTES=16777216
# Bytes one connection may queue before its document authenticates.
# SYNC_MAX_PREAUTH_BYTES=33554432
# Bytes all connections together may queue before authenticating.
# SYNC_MAX_PREAUTH_TOTAL_BYTES=268435456
# A connection that sends for a document without its token within this time is closed.
# SYNC_AUTH_TIMEOUT_MS=15000
# Open sync connections per client IP.
# SYNC_MAX_CONNECTIONS_PER_IP=
# A snapshot of a document is written once it has more stored updates than this since its last snapshot (loading then starts from the snapshot; no history is removed).
# COMPACT_THRESHOLD=500
# How often the compaction sweep runs (ms); ≤ 0 = off.
# COMPACT_INTERVAL_MS=900000
# Most documents compacted per sweep.
# COMPACT_MAX_DOCS_PER_RUN=50
# Days of edit history that stay restorable. Older Y.js rows are deleted below a snapshot, and Activity Log restores/diffs from before then answer 410. 0 = keep all history. Must be at least the longest plan history window (TIER_*_HISTORY_DAYS).
# COMPACT_RETAIN_HISTORY_DAYS=0

# ─── Renderer (PDF / PNG) ────────────────────────────────────────────────────
# Playwright sidecar that renders documents. Internal-only.
# Internal URL of the renderer; set but empty disables PDF download and the AI's view_pages tool.
NUXT_RENDERER_INTERNAL_URL=http://localhost:9000
# Extra origins the renderer's Chromium may load (beyond the app and S3). Mirrored into the print page CSP: set it on app AND renderer.
# RENDERER_ALLOWED_ORIGINS=
# Chromium's own sandbox; false only on hosts without unprivileged user namespaces.
# RENDERER_CHROMIUM_SANDBOX=true
# Where Chromium resolves `localhost` (dev/test: the SeaweedFS container).
# RENDERER_LOCALHOST_TARGET=host.docker.internal

# ─── LiteLLM proxy ───────────────────────────────────────────────────────────
# Every platform-paid AI call goes through the self-hosted LiteLLM proxy (deploy/config/litellm/). Per-user virtual keys carry the budgets.
# Internal URL of the proxy.
NUXT_LITELLM_URL=http://localhost:4000
# Admin key the app mints virtual keys with; must equal LITELLM_MASTER_KEY.
NUXT_LITELLM_MASTER_KEY=
# Master key the proxy starts with (sk-…).
LITELLM_MASTER_KEY=
# Encrypts provider keys in LiteLLM's own database. Never change it on a running instance: LiteLLM can no longer read what it stored.
LITELLM_SALT_KEY=
# Full URL of LiteLLM's spend database for the app's spend reads; empty = built from the parts below + POSTGRES_HOST/PORT.
# NUXT_LITELLM_DB_URL=
# Role the app reads LiteLLM's spend logs as; empty = POSTGRES_USER (and POSTGRES_PASSWORD).
# NUXT_LITELLM_DB_USER=
# Password of NUXT_LITELLM_DB_USER.
# NUXT_LITELLM_DB_PASSWORD=
# LiteLLM's database name.
# NUXT_LITELLM_DB_NAME=litellm
# Embedding model alias for the knowledge base; `custom-embeddings` = the EMBEDDINGS_UPSTREAM_* deployment.
# NUXT_LITELLM_EMBEDDINGS_MODEL=jina-embeddings-v5-text-nano
# Embedding size (the pgvector column is retyped at boot while empty; else `bun run knowledge:reembed`).
# NUXT_LITELLM_EMBEDDINGS_DIMS=768
# Send the OpenAI `dimensions` parameter (auto = Jina models only).
# NUXT_LITELLM_EMBEDDINGS_SEND_DIMENSIONS=auto
# Send Jina's `task` parameter (auto = Jina models only).
# NUXT_LITELLM_EMBEDDINGS_TASK_HINTS=auto
# Label only (stored with the vectors): mirrors the proxy's EMBEDDINGS_UPSTREAM_MODEL.
# NUXT_LITELLM_EMBEDDINGS_UPSTREAM_MODEL=
# LiteLLM model id behind `custom-embeddings` (e.g. openai/text-embedding-3-small).
# EMBEDDINGS_UPSTREAM_MODEL=
# API base of the custom embeddings upstream.
# EMBEDDINGS_UPSTREAM_API_BASE=
# API key of the custom embeddings upstream.
# EMBEDDINGS_UPSTREAM_API_KEY=
# Default width of generated images.
# NUXT_LITELLM_IMAGE_DEFAULT_WIDTH=1024
# Default height of generated images.
# NUXT_LITELLM_IMAGE_DEFAULT_HEIGHT=1024
# Metering model billed once per minute of live dictation.
# NUXT_LITELLM_REALTIME_TICK_MODEL=voxtral-realtime-tick

# ─── AI provider keys ────────────────────────────────────────────────────────
# Platform-paid upstreams. MISTRAL / BFL / JINA are read by LiteLLM; JINA (fetch_url), STAAN (web_search) and MISTRAL (live dictation) also by the app.
# Jina: embeddings (proxy) and the fetch_url tool (app). Empty = fetch_url not offered.
JINA_AI_API_KEY=
# Mistral (EU endpoint): chat / transcription deployments (proxy) and live dictation on the platform default (app).
MISTRAL_API_KEY=
# Black Forest Labs image generation (proxy only).
BFL_API_KEY=
# Staan web search for the web_search tool. Empty = web_search not offered.
STAAN_API_KEY=
# web_search + fetch_url calls per user per rolling hour (0 = unlimited).
# NUXT_WEB_TOOLS_HOURLY_LIMIT=30
# web_search + fetch_url calls per user per rolling day (0 = unlimited).
# NUXT_WEB_TOOLS_DAILY_LIMIT=100

# ─── AI defaults and bring-your-own-key ──────────────────────────────────────
# Per request: the user's own provider → the instance default below → unavailable. See docs/AI-MODELS.md.
# Instance default for chat: a LiteLLM alias (platform-paid), or with _BASE_URL + _API_KEY any OpenAI-compatible model. Empty = none.
# NUXT_AI_DEFAULT_CHAT_MODEL=
# OpenAI-compatible endpoint of the chat default (needs _MODEL and _API_KEY).
# NUXT_AI_DEFAULT_CHAT_BASE_URL=
# API key for NUXT_AI_DEFAULT_CHAT_BASE_URL (any placeholder for servers that need none).
# NUXT_AI_DEFAULT_CHAT_API_KEY=
# The chat default accepts images (view_image / view_pages).
# NUXT_AI_DEFAULT_CHAT_VISION=true
# Stronger LiteLLM chat alias users may pick when their plan has aiStrongModel. Empty = default model only.
# NUXT_AI_DEFAULT_CHAT_STRONG_MODEL=
# Instance default for image generation: a LiteLLM alias (platform-paid), or with _BASE_URL + _API_KEY any OpenAI-compatible model. Empty = none.
# NUXT_AI_DEFAULT_IMAGE_MODEL=
# OpenAI-compatible endpoint of the image generation default (needs _MODEL and _API_KEY).
# NUXT_AI_DEFAULT_IMAGE_BASE_URL=
# API key for NUXT_AI_DEFAULT_IMAGE_BASE_URL (any placeholder for servers that need none).
# NUXT_AI_DEFAULT_IMAGE_API_KEY=
# Instance default for transcription: a LiteLLM alias (platform-paid), or with _BASE_URL + _API_KEY any OpenAI-compatible model. Empty = none.
# NUXT_AI_DEFAULT_TRANSCRIBE_MODEL=
# OpenAI-compatible endpoint of the transcription default (needs _MODEL and _API_KEY).
# NUXT_AI_DEFAULT_TRANSCRIBE_BASE_URL=
# API key for NUXT_AI_DEFAULT_TRANSCRIBE_BASE_URL (any placeholder for servers that need none).
# NUXT_AI_DEFAULT_TRANSCRIBE_API_KEY=
# Voxtral Realtime model for live dictation (Mistral only).
# NUXT_AI_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
# Allowlist of provider base URLs users may configure. Empty = any public URL. Required with NUXT_LEGAL_SURFACES_ENABLED=true.
# NUXT_AI_BYOK_ALLOWED_BASE_URLS=
# Let users point at private-network providers (Ollama, vLLM). Self-host only.
# NUXT_AI_BYOK_ALLOW_PRIVATE_URLS=false
# Monthly ceiling (USD) on platform-paid AI of all free-tier users together (LiteLLM team budget). 0 = none.
# NUXT_FREE_TIER_TOTAL_BUDGET_USD=0

# ─── Billing ─────────────────────────────────────────────────────────────────
# One codebase, three shapes: self-host (both off), hosted free-only (coming soon on), paid plans live (billing on → Stripe required in production).
# Stripe checkout / portal / webhooks and paid tiers are live. Off = everyone on the free tier, billing endpoints 404.
NUXT_BILLING_ENABLED=false
# With billing off: show paid plans as "coming soon" + the waitlist (hosted free-only SaaS).
NUXT_PLANS_COMING_SOON=false
# Stripe secret key.
NUXT_STRIPE_SECRET_KEY=
# Stripe webhook signing secret.
NUXT_STRIPE_WEBHOOK_SECRET=
# Prefix of the Stripe price lookup keys (<prefix>_<plan>_<month|year>_<eur|chf>).
# NUXT_STRIPE_LOOKUP_KEY_PREFIX=markoto
# Explicit `lookup_key=price_id` pairs, comma-separated, for setups without lookup keys.
# NUXT_STRIPE_PRICE_IDS=
# Stripe Tax on checkout (only after activating Stripe Tax in the dashboard).
# NUXT_STRIPE_AUTOMATIC_TAX=false
# Path Stripe returns to after a successful checkout.
# NUXT_STRIPE_SUCCESS_URL=/pricing?checkout=success&session={CHECKOUT_SESSION_ID}
# Path Stripe returns to after a cancelled checkout.
# NUXT_STRIPE_CANCEL_URL=/pricing?checkout=cancelled

# ─── Plan limits and feature switches ────────────────────────────────────────
# TIER_<FREE|PRO|TEAM|BUSINESS>_<FIELD>. Numbers > 0, `unlimited` for the per-day / member / history limits, booleans for FEATURE_*. With billing off everyone is on FREE, so TIER_FREE_* are every account's limits.
# free plan: litellmBudgetUsd (committed default in shared/config/tiers.ts).
# TIER_FREE_LITELLM_BUDGET_USD=
# free plan: workspacesOwned (committed default in shared/config/tiers.ts).
# TIER_FREE_WORKSPACES_OWNED=
# free plan: knowledgeFiles (committed default in shared/config/tiers.ts).
# TIER_FREE_KNOWLEDGE_FILES=
# free plan: knowledgeBytesPerWorkspace (committed default in shared/config/tiers.ts).
# TIER_FREE_KNOWLEDGE_BYTES_PER_WORKSPACE=
# free plan: knowledgeBytesPerUser (committed default in shared/config/tiers.ts).
# TIER_FREE_KNOWLEDGE_BYTES_PER_USER=
# free plan: imageBytesPerUser (committed default in shared/config/tiers.ts).
# TIER_FREE_IMAGE_BYTES_PER_USER=
# free plan: membersPerWorkspace (committed default in shared/config/tiers.ts).
# TIER_FREE_MEMBERS_PER_WORKSPACE=
# free plan: historyDays (committed default in shared/config/tiers.ts).
# TIER_FREE_HISTORY_DAYS=
# free plan: savedThemes (committed default in shared/config/tiers.ts).
# TIER_FREE_SAVED_THEMES=
# free plan: importMaxBytes (committed default in shared/config/tiers.ts).
# TIER_FREE_IMPORT_MAX_BYTES=
# free plan: webToolsPerDay (committed default in shared/config/tiers.ts).
# TIER_FREE_WEB_TOOLS_PER_DAY=
# free plan: mcpToolCallsPerDay (committed default in shared/config/tiers.ts).
# TIER_FREE_MCP_TOOL_CALLS_PER_DAY=
# free plan: customCss (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_CUSTOM_CSS=
# free plan: mcpWrite (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_MCP_WRITE=
# free plan: aiImage (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_AI_IMAGE=
# free plan: aiVoice (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_AI_VOICE=
# free plan: aiStrongModel (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_AI_STRONG_MODEL=
# free plan: sso (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_SSO=
# free plan: auditLog (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_AUDIT_LOG=
# free plan: guests (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_GUESTS=
# free plan: brandKit (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_BRAND_KIT=
# free plan: shareControls (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_SHARE_CONTROLS=
# free plan: customDomains (committed default in shared/config/tiers.ts).
# TIER_FREE_FEATURE_CUSTOM_DOMAINS=
# TIER_PRO_* / TIER_TEAM_* / TIER_BUSINESS_* take the same fields; TIER_<PLAN>_PRICE_<EUR|CHF>[_YEAR] the planned prices.

# ─── Legal surfaces and retention ────────────────────────────────────────────
# Onboarding gate, DPA step, /legal/* pages and the operator identity rendered into them. The bundled texts describe the hosted markoto.app service: off by default.
# Onboarding gate (age + Privacy + ToS), DPA step, /legal/* pages and footer links. Hosted: true.
# NUXT_LEGAL_SURFACES_ENABLED=false
# Legal entity operating the instance (also the footer's operator name). Default: LatentSpace Labs GmbH (legal surfaces on).
# NUXT_LEGAL_CONTROLLER_NAME=
# Postal address of the operator. No default.
# NUXT_LEGAL_CONTROLLER_ADDRESS=
# Inbox for data-subject requests (the hosted service uses one address for general contact, privacy and abuse). Default: hello@markoto.app.
# NUXT_LEGAL_PRIVACY_CONTACT_EMAIL=
# Inbox for DSA abuse reports; also receives abuse-report notifications on any instance. Default: hello@markoto.app (legal surfaces on).
# NUXT_LEGAL_ABUSE_CONTACT_EMAIL=
# Choice of law of the Terms. Default: Swiss law.
# NUXT_LEGAL_GOVERNING_LAW=
# Legal form, for the imprint. Default: Gesellschaft mit beschränkter Haftung (GmbH).
# NUXT_LEGAL_LEGAL_FORM=
# Registered office, for the imprint. Default: Zürich, Switzerland.
# NUXT_LEGAL_REGISTERED_OFFICE=
# Person(s) authorised to represent the operator (imprint). No default.
# NUXT_LEGAL_REPRESENTED_BY=
# Swiss business identification number. Default: CHE-170.986.632.
# NUXT_LEGAL_UID=
# Commercial-register id. Default: CH-020-4092420-2.
# NUXT_LEGAL_CH_ID=
# EHRA id. Default: 1753104.
# NUXT_LEGAL_EHRA_ID=
# Audit-log rows older than this are deleted (0 = keep forever).
# NUXT_AUDIT_LOG_RETENTION_DAYS=730
# Closed abuse reports are deleted this many days after closing (0 = keep forever).
# NUXT_ABUSE_REPORT_RETENTION_DAYS=365
# Anonymous documents (no owner, no workspace) are deleted after this many days without activity (0 = never).
# NUXT_INACTIVE_DOC_TTL_DAYS=30
# Anonymous visitors accept the Terms (age ≥ 16) and pass an ALTCHA bot check before their first document / an anonymous report.
# NUXT_ANON_GATE_ENABLED=
# HMAC key of the ALTCHA challenge and the remembered-terms cookie.
NUXT_ALTCHA_HMAC_KEY=

# ─── Transactional email ─────────────────────────────────────────────────────
# Resend. Without RESEND_API_KEY every email is logged instead of sent.
# Resend API key; set = real delivery.
# RESEND_API_KEY=
# Sender, e.g. `markoto <noreply@example.org>` (verified domain). Empty = Resend's sandbox sender.
# NUXT_EMAIL_FROM=
# `stub` logs instead of sending even with a key (staging, tests).
# NUXT_EMAIL_PROVIDER=

# ─── Instance co-branding ────────────────────────────────────────────────────
# Managed private instance: the customer's name, logo and support contact beside the markoto wordmark. All empty = nothing changes.
# Customer name shown beside the wordmark (max 60 chars).
# NUXT_INSTANCE_BRAND_NAME=
# Path of the logo file inside the app container (svg, png, webp, jpg).
# NUXT_INSTANCE_BRAND_LOGO=
# Help / service-desk page of this instance.
# NUXT_INSTANCE_SUPPORT_URL=
# Support email address of this instance.
# NUXT_INSTANCE_SUPPORT_EMAIL=

# ─── Published pages and custom domains ──────────────────────────────────────
# Publishing at /p/<slug> always works. A pages host of its own is required for the hosted shape; custom domains need a CNAME target that reaches this instance's Traefik.
# Hostname published pages are served from (pages.example.org, or an https:// origin). Must differ from the app host. Empty = the app's own origin.
# NUXT_PUBLISH_PAGES_HOST=
# Host customers point their CNAME at. Empty = custom domains off.
# NUXT_PUBLISH_DOMAINS_TARGET=
# Token Traefik's HTTP provider sends to /api/internal/traefik/custom-domains. Unset = the endpoint is off.
# NUXT_PUBLISH_TRAEFIK_TOKEN=
# Traefik entry point of the generated routers.
# NUXT_PUBLISH_TRAEFIK_ENTRYPOINT=websecure
# Traefik certificate resolver of the generated routers.
# NUXT_PUBLISH_TRAEFIK_CERT_RESOLVER=le
# Existing Traefik service the generated routers point at.
# NUXT_PUBLISH_TRAEFIK_SERVICE=app@docker
# Traefik middlewares attached to the generated routers.
# NUXT_PUBLISH_TRAEFIK_MIDDLEWARES=
# Also emit the pages host's router from the HTTP provider (self-host HTTPS overlay).
# NUXT_PUBLISH_TRAEFIK_PAGES_ROUTER=false

# ─── Error reporting (Sentry) ────────────────────────────────────────────────
# Optional. Empty keeps telemetry off.
# Browser DSN (runtimeConfig.public.sentry.dsn); also the server DSN when SENTRY_DSN is empty.
NUXT_PUBLIC_SENTRY_DSN=
# Server-side DSN of the app, sync server and renderer.
SENTRY_DSN=
# Build time only: uploads source maps during `bun run build`.
# SENTRY_AUTH_TOKEN=
# Build time only: Sentry organisation for the source-map upload.
# SENTRY_ORG=
# Build time only: Sentry project for the source-map upload.
# SENTRY_PROJECT=
# Domain shown in the fake browser bar above the docs' flow screenshots (runtimeConfig.public.docs.chromeDomain).
# NUXT_PUBLIC_DOCS_CHROME_DOMAIN=markoto.app

# ─── Deployment (compose only) ───────────────────────────────────────────────
# Interpolated by the compose files; no process reads them directly.
# Hosted: apex domain (app at https://<DOMAIN>).
DOMAIN=
# Hosted: Let's Encrypt account email.
ACME_EMAIL=
# Image registry prefix (ghcr.io/<owner>).
REGISTRY=
# Image tag to run (pin a version; no implicit latest).
IMAGE_TAG=
# Hash of deploy/config/litellm/*: recreates the proxy when its config changes (set by every deploy path).
# LITELLM_CONFIG_HASH=
# Deprecated alias of NUXT_MARKETING_SITE_ENABLED, resolved by deploy/compose/compose.prod.yml.
# NUXT_PRODUCT_TOUR_ENABLED=
# Self-host: instance name (Traefik constraint, network names).
# MARKOTO_INSTANCE=
# Self-host: public URL (becomes NUXT_SITE_URL).
# MARKOTO_PUBLIC_URL=
# Self-host: browser WebSocket URL (becomes NUXT_PUBLIC_SYNC_URL).
# MARKOTO_SYNC_URL=
# Self-host TLS overlay: domain of the Let's Encrypt certificate.
# MARKOTO_DOMAIN=
# Self-host: published HTTP port.
# MARKOTO_HTTP_PORT=
# Self-host: address the HTTP port binds.
# MARKOTO_HTTP_BIND=
# Self-host TLS overlay: published HTTPS port.
# MARKOTO_HTTPS_PORT=
# Self-host TLS overlay: address the HTTPS port binds.
# MARKOTO_HTTPS_BIND=
# Self-host: proxies whose X-Forwarded-* Traefik trusts.
# TRAEFIK_TRUSTED_IPS=
# Hosted deploy (infra/render-env.sh): managed Postgres host; set = verify its TLS against OVH_PG_CA_REMOTE_PATH.
# OVH_PG_HOST=
# Hosted deploy: path of the managed Postgres CA certificate on the server.
# OVH_PG_CA_REMOTE_PATH=/opt/markoto/secrets/ovh-pg-ca.pem
# Docker / Podman socket path for the socket proxy. Hosted: exported by the markoto-compose wrapper (the markoto user's rootless Podman socket), not set in .env.
# CONTAINER_SOCKET=

# ─── Backups ─────────────────────────────────────────────────────────────────
# The backup sidecar (`pg_dump | gzip | gpg → S3`). Its storage defaults to the app's NUXT_S3_* bucket and credentials.
# Seconds between backups.
BACKUP_INTERVAL_SECONDS=86400
# Backups kept.
BACKUP_RETENTION_COUNT=30
# Symmetric gpg passphrase; rotating it makes older backups unrestorable without the old one.
BACKUP_GPG_PASSPHRASE=
# Dedicated backup endpoint (empty = NUXT_S3_ENDPOINT).
BACKUP_S3_ENDPOINT=
# Dedicated backup bucket (empty = NUXT_S3_BUCKET).
BACKUP_S3_BUCKET=
# Key scoped to the backup bucket (empty = NUXT_S3_ACCESS_KEY).
BACKUP_S3_ACCESS_KEY=
# Secret of BACKUP_S3_ACCESS_KEY.
BACKUP_S3_SECRET_KEY=
# Region of the backup bucket.
BACKUP_S3_REGION=
# Key prefix of the backups (default backups/postgres).
BACKUP_S3_PREFIX=
