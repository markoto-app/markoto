# markoto — environment template (development + hosted deploys).
#
# Self-hosting? Don't copy this file: run ./install.sh, which writes a
# complete .env for docker-compose.selfhost.yml (docs/SELF-HOSTING.md).
#
# Two scenarios share this file. Skip the section that doesn't apply.
#
#   1) Daily dev: `docker compose -f docker-compose.dev.yml up -d` (infra only)
#      + `bun run dev` on the host. The connection strings under "App ↔ infra"
#      below are wired to the hardcoded credentials in docker-compose.dev.yml
#      — match them verbatim.
#
#   2) Prod deploy via docker-compose.prod.yml. The compose file builds
#      DATABASE_URL / VALKEY_URL from POSTGRES_PASSWORD + VALKEY_PASSWORD
#      inline, so leave those two URL lines blank in prod and fill the
#      "Production deploy only" block at the bottom.
#
# Policy: no shell-default fallbacks (`${X:-default}`) in any compose file.
# Either set a value here or the stack refuses to start. server/plugins/01-validate-secrets.ts
# enforces presence at app boot for every required NUXT_* below.

# ─────────────────────────────────────────────────────────────────────
# Required — app secrets (≥32 chars each; `openssl rand -hex 32`)
# ─────────────────────────────────────────────────────────────────────
NUXT_SESSION_PASSWORD=
NUXT_JWT_SECRET=
NUXT_INTERNAL_API_SECRET=

# Optional, only set during a rotation window — see docs/SECRETS-ROTATION.md.
NUXT_JWT_SECRET_PREVIOUS=
NUXT_INTERNAL_API_SECRET_PREVIOUS=

# ─────────────────────────────────────────────────────────────────────
# Required — Postgres + Valkey, atomic parts. shared/utils/connectionStrings.ts
# composes the actual DATABASE_URL/VALKEY_URL on demand so .env never
# carries a composed URL alongside the parts that built it.
#
# DEV (host bun + docker-compose.dev.yml infra): use the values shown —
# *_HOST is `localhost` because bun runs on the host and reaches the
# containers via published ports.
# PROD/LOCAL (containerised app): the compose file overrides *_HOST to
# the docker service name (`postgres`, `valkey`) inline; .env still owns
# the credentials.
# ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=ypad
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=ypad
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional separate least-privilege roles (docs/SECURITY-HARDENING.md §C.5).
# Unset = the app and LiteLLM use POSTGRES_USER. With them set, the db-init
# one-shot creates the roles and the containerised stacks (local / prod /
# self-host) connect as them; POSTGRES_USER stays the admin role.
# POSTGRES_APP_USER=markoto_app
# POSTGRES_APP_PASSWORD=
# POSTGRES_LITELLM_USER=litellm
# POSTGRES_LITELLM_PASSWORD=

VALKEY_HOST=localhost
VALKEY_PORT=6379
# DEV/TEST: defaults to `devpassword` in docker-compose.dev.yml /
# .test.yml; match that here so `bun run dev` on the host can authenticate
# to the container. PROD/LOCAL compose files force this with `:?required`
# — generate with `openssl rand -hex 32`.
VALKEY_PASSWORD=devpassword
# Logical DB index. Default 0 is fine; bump to isolate keyspaces.
VALKEY_DB=0
# Optional — Valkey TLS opt-in. Leave `false` for self-hosted single-VPS
# deploys: the docker network IS the trust boundary and TLS is overkill.
# Set `true` if Valkey is on a different host or behind a managed-Redis
# provider (Infomaniak managed Valkey, AWS ElastiCache, OVH Redis-as-a-
# service, etc.). When true, the client uses ioredis's TLS support against
# the system CA store; provide VALKEY_TLS_CA_PATH only if the provider
# uses a private CA. See docs/SECURITY-HARDENING.md.
VALKEY_TLS_ENABLED=false
# VALKEY_TLS_CA_PATH=/path/to/provider-ca.pem

# ─────────────────────────────────────────────────────────────────────
# Required — other app ↔ infra endpoints.
# DEV: leave the values exactly as shown — they match docker-compose.dev.yml.
# ─────────────────────────────────────────────────────────────────────
NUXT_S3_ENDPOINT=http://localhost:8333
NUXT_S3_ACCESS_KEY=ypad-access-key
NUXT_S3_SECRET_KEY=ypad-secret-key
NUXT_S3_BUCKET=ypad
# Optional — base URL browsers use for presigned S3 URLs when it differs from
# NUXT_S3_ENDPOINT (the self-host stack publishes SeaweedFS through Traefik on
# the public origin). Empty = NUXT_S3_ENDPOINT. SigV4 signs the host, so this
# must be exactly what the browser connects to.
# NUXT_S3_PUBLIC_ENDPOINT=https://docs.example.org

NUXT_MARKITDOWN_URL=http://localhost:8080
NUXT_SYNC_INTERNAL_URL=http://localhost:4001
NUXT_PUBLIC_SYNC_URL=ws://localhost:4001
# Backend renderer container — Playwright + Chromium that produces PDFs and
# per-page PNGs. Internal-network only in compose; empty in dev disables the
# user-facing /api/docs/:id/pdf endpoint and the AI's view_pages tool.
NUXT_RENDERER_INTERNAL_URL=http://localhost:9000
# Optional — extra origins the renderer's Chromium may fetch from (comma-separated,
# e.g. https://images.example.org). By default it may only reach the app, the S3
# host presigned images use, and the pinned CDNs (jsDelivr, Google Fonts); every
# other request (internal services, cloud metadata) is aborted. Also mirrored into
# the print page's CSP, so set it for BOTH the app and renderer containers.
# RENDERER_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────
# Required — LiteLLM proxy. Phase 5: every AI surface (embeddings, text
# loop, image gen, transcribe, dictate ticks) routes through this single
# gateway. The master key authenticates admin + virtual-key APIs;
# per-user virtual keys are minted lazily on first AI call.
#
# Generate strong values:
#   LITELLM_MASTER_KEY=sk-$(openssl rand -hex 32)
#   LITELLM_SALT_KEY=sk-$(openssl rand -hex 32)
# ─────────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
NUXT_LITELLM_URL=http://litellm:4000
NUXT_LITELLM_MASTER_KEY=

# AI provider keys. MISTRAL_API_KEY + BFL_API_KEY are consumed by LiteLLM
# only (the proxy multiplexes them per model in infra/litellm/config.yaml).
# JINA_AI_API_KEY is used BOTH by LiteLLM (embeddings) AND directly by the
# Nuxt app process (the fetch_url tool's Jina Reader call), so it must be
# present in the app container env, not just the litellm container.
JINA_AI_API_KEY=
MISTRAL_API_KEY=
BFL_API_KEY=
# Staan (staan.ai) — European web-search index backing the web_search tool.
# Read directly by the Nuxt app process. Enable EU-only routing (disable the
# US fallback) in the Staan dashboard; there is no per-request parameter.
STAAN_API_KEY=
# Both web tools (web_search = Staan, fetch_url = Jina Reader) are
# platform-paid: the operator pays the upstream call, the user's chat model
# (their own key under BYOK) pays the synthesis tokens. Leave a key empty and
# that tool is not offered to the AI. Per-user allowance, shared by the
# editor AI and MCP (calls per rolling hour / day; 0 = unlimited):
# NUXT_WEB_TOOLS_HOURLY_LIMIT=30
# NUXT_WEB_TOOLS_DAILY_LIMIT=100

# Optional — distinct JWT secret for the dictation WS so a compromised
# Hocuspocus secret can't forge dictation tokens (and vice versa).
# Falls back to NUXT_JWT_SECRET when empty (fine for dev).
NUXT_AI_DICTATE_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# AI providers — bring your own key (BYOK). See docs/AI-MODELS.md.
#
# Users configure their own OpenAI-compatible provider per capability
# (chat, image, transcription) under Settings → AI provider. Per request
# the app uses: the user's own config → the instance default below →
# unavailable (the feature is hidden / shows "Add your API key").
#
# Instance defaults (optional, per capability):
#   *_MODEL alone             → a model alias from infra/litellm/config.yaml
#                               (e.g. mistral-small-2603). Platform-paid:
#                               calls debit the user's AI Points budget.
#   *_MODEL + *_BASE_URL + *_API_KEY → any OpenAI-compatible endpoint,
#                               used like a user key (zero-cost to the AI
#                               Points budget). Operator defaults may point
#                               at private networks (e.g. Ollama at
#                               http://host.docker.internal:11434/v1, any
#                               placeholder key) without the opt-in below.
# The hosted SaaS sets only NUXT_AI_DEFAULT_CHAT_MODEL=zai-glm-5-3-flash (the
# free AI allowance, docs/AI-MODELS.md#free-ai-allowance-hosted). Today's
# Mistral/BFL/Voxtral setup for a self-hoster:
#   NUXT_AI_DEFAULT_CHAT_MODEL=mistral-small-2603
#   NUXT_AI_DEFAULT_IMAGE_MODEL=flux-2-pro
#   NUXT_AI_DEFAULT_TRANSCRIBE_MODEL=voxtral-mini-transcribe
# (live dictation on that default also needs MISTRAL_API_KEY in the app env).
# ─────────────────────────────────────────────────────────────────────
NUXT_AI_DEFAULT_CHAT_MODEL=
NUXT_AI_DEFAULT_CHAT_BASE_URL=
NUXT_AI_DEFAULT_CHAT_API_KEY=
# Chat model accepts image input (view_image / view_pages tools). Default true.
NUXT_AI_DEFAULT_CHAT_VISION=
NUXT_AI_DEFAULT_IMAGE_MODEL=
NUXT_AI_DEFAULT_IMAGE_BASE_URL=
NUXT_AI_DEFAULT_IMAGE_API_KEY=
NUXT_AI_DEFAULT_TRANSCRIBE_MODEL=
NUXT_AI_DEFAULT_TRANSCRIBE_BASE_URL=
NUXT_AI_DEFAULT_TRANSCRIBE_API_KEY=
# Voxtral Realtime model for live dictation (Mistral only). Default below.
# NUXT_AI_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
#
# BYOK URL policy (SSRF protection — server/utils/aiProviders/urlPolicy.ts).
# Comma-separated allowlist of provider base URLs users may pick. Empty =
# any public https URL (self-hosted). Required (boot fails when empty) on
# the hosted shape, i.e. with NUXT_LEGAL_SURFACES_ENABLED=true; every entry
# must be an absolute http(s) URL. The hosted SaaS uses:
#   https://api.mistral.ai/v1,https://api.openai.com/v1,https://openrouter.ai/api/v1,https://api.groq.com/openai/v1,https://api.together.xyz/v1,https://api.deepinfra.com/v1/openai,https://api.fireworks.ai/inference/v1,https://api.scaleway.ai/v1
NUXT_AI_BYOK_ALLOWED_BASE_URLS=
# Self-hosted only: let users point at private-network endpoints (Ollama,
# vLLM on the LAN, http://host.docker.internal:11434/v1). Plain http is
# then allowed for private addresses only. Loopback, link-local/metadata
# and markoto's own service hostnames are always refused. Default false.
NUXT_AI_BYOK_ALLOW_PRIVATE_URLS=false

# ─────────────────────────────────────────────────────────────────────
# Optional — OAuth (login). Empty pair = anonymous-only deploy.
# Pair-validated at boot: id + secret per provider must be both-or-neither.
# ─────────────────────────────────────────────────────────────────────
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Generic OpenID Connect — your own IdP (Authentik, Keycloak, Authelia,
# Pocket ID, Zitadel, Dex, ...). Self-hosted feature; the hosted SaaS does
# not set it. Issuer + client id + client secret: all three or none (boot
# fails otherwise). The issuer is the exact `issuer` value of the IdP's
# /.well-known/openid-configuration and must be https (http is accepted
# only with NODE_ENV=development or TEST_MODE=1). Register the redirect
# URI <public URL>/auth/oidc at the IdP (confidential client, auth-code
# flow, PKCE S256). Users are keyed by (issuer, sub); the email is only
# used when the IdP sends email_verified=true. See docs/SELF-HOSTING.md#login.
NUXT_OAUTH_OIDC_ISSUER=
NUXT_OAUTH_OIDC_CLIENT_ID=
NUXT_OAUTH_OIDC_CLIENT_SECRET=
# Optional: button label ("Continue with <name>"); empty = "single sign-on".
NUXT_OAUTH_OIDC_NAME=
# Optional: space-separated scopes; default "openid email profile".
# NUXT_OAUTH_OIDC_SCOPES=openid email profile
# Optional: explicit redirect URI; default <NUXT_SITE_URL>/auth/oidc (never
# the request Host header). One of the two must be set, or boot fails.
# NUXT_OAUTH_OIDC_REDIRECT_URL=https://docs.example.org/auth/oidc

# ─────────────────────────────────────────────────────────────────────
# Optional — model + tunable overrides. nuxt.config.ts holds the defaults
# (see AGENTS.md §7 for rationale). Uncomment only to override.
# ─────────────────────────────────────────────────────────────────────
# Knowledge-base embeddings (self-hosters; hosted markoto keeps the Jina
# default and does not expose this). Defaults: Jina v5-text-nano @ 768 dims.
# To use another provider, select the operator-configurable proxy deployment
# and tell it where to go, e.g. OpenAI text-embedding-3-small:
#   NUXT_LITELLM_EMBEDDINGS_MODEL=custom-embeddings
#   NUXT_LITELLM_EMBEDDINGS_DIMS=1536            # model output size, max 2000
#   EMBEDDINGS_UPSTREAM_MODEL=openai/text-embedding-3-small   # any LiteLLM model id
#   EMBEDDINGS_UPSTREAM_API_BASE=https://api.openai.com/v1
#   EMBEDDINGS_UPSTREAM_API_KEY=sk-...
# The EMBEDDINGS_UPSTREAM_* trio is read by the LiteLLM container (the app only
# uses _MODEL as a label). Optional app-side switches (auto|true|false; auto =
# "yes for Jina models only"): NUXT_LITELLM_EMBEDDINGS_SEND_DIMENSIONS sends
# the OpenAI `dimensions` param (needed to shrink text-embedding-3-*; most
# other models reject it), NUXT_LITELLM_EMBEDDINGS_TASK_HINTS sends Jina's
# `task` param. Changing the dimension on a knowledge base that already holds
# vectors needs `bun run knowledge:reembed`. See docs/AI-MODELS.md#embeddings.
# NUXT_LITELLM_EMBEDDINGS_MODEL=jina-embeddings-v5-text-nano
# NUXT_LITELLM_EMBEDDINGS_DIMS=768
# NUXT_LITELLM_EMBEDDINGS_SEND_DIMENSIONS=auto
# NUXT_LITELLM_EMBEDDINGS_TASK_HINTS=auto
# EMBEDDINGS_UPSTREAM_MODEL=openai/text-embedding-3-small
# EMBEDDINGS_UPSTREAM_API_BASE=https://api.openai.com/v1
# EMBEDDINGS_UPSTREAM_API_KEY=
# NUXT_LITELLM_REALTIME_TICK_MODEL=voxtral-realtime-tick
# NUXT_INACTIVE_DOC_TTL_DAYS=180
# NUXT_PUBLIC_DOCS_CHROME_DOMAIN=markoto.app
# Slow-query threshold (ms). Queries above this fire a warning-level
# Sentry event (component=db, event=slow_query). Default 200.
# NUXT_DB_SLOW_QUERY_MS=200

# ─────────────────────────────────────────────────────────────────────
# Optional — Sentry (sentry.io). Empty in dev keeps telemetry silent.
# In prod, create a Sentry project, copy its DSN here, then redeploy.
# ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SENTRY_DSN=
# Optional — separate backend-only DSN if you want browser vs server
# in distinct Sentry projects. When empty, the server uses
# NUXT_PUBLIC_SENTRY_DSN for both.
SENTRY_DSN=

# Optional — BUILD-TIME only. Used by @sentry/nuxt's source-map upload
# during `bun run build`. Without these three, frontend stack traces
# arrive minified and the build still succeeds — but on-call has to
# map line numbers by hand. Set in CI / build env, NOT in the runtime
# `app` container. See docs/DEPLOY.md.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────────────
# Billing mode (shared/config/billingMode.ts). One codebase, three shapes:
#
#   NUXT_BILLING_ENABLED  NUXT_PLANS_COMING_SOON  → deployment shape
#   false (default)       false (default)         self-hosted: everyone on
#                                                 the free tier (raise it
#                                                 with TIER_FREE_* below),
#                                                 no pricing links, no
#                                                 Stripe, no waitlist
#   false                 true                    hosted free-only SaaS:
#                                                 pricing page shows paid
#                                                 plans as "coming soon"
#                                                 + a double-opt-in waitlist
#   true                  (ignored)               paid plans live: Stripe
#                                                 checkout / portal /
#                                                 webhooks, Stripe vars
#                                                 below REQUIRED in prod
#
# Accepted truthy values: 1 / true / yes / on. Anything else = false.
# With billing off, /api/billing/{checkout,portal}, the Stripe webhook and
# the workspace AI-sponsorship toggle answer 404 `billing/disabled`.
# ─────────────────────────────────────────────────────────────────────
NUXT_BILLING_ENABLED=false
NUXT_PLANS_COMING_SOON=false

# ─────────────────────────────────────────────────────────────────────
# Instance shape (shared/config/instance.ts).
#
# NUXT_LEGAL_SURFACES_ENABLED — onboarding gate (age + privacy + terms),
# cookie-consent banner, DPA step for workspace owners, /legal/* pages and
# footer links. The bundled texts describe the HOSTED markoto.app service,
# so the default is OFF (self-hosting); the hosted SaaS sets true
# (docker-compose.prod.yml, infra/render-env.sh, infra/templates/env.j2).
# Set true in dev to work on those surfaces.
#
# NUXT_PRODUCT_TOUR_ENABLED — the scroll-driven product page at / for
# logged-out visitors (it advertises the hosted markoto.app service).
# Default OFF: self-hosted instances keep the plain "new document" page.
# The hosted SaaS sets true (prod compose, render-env.sh, env.j2).
#
# NUXT_TRUSTED_PROXY_HOPS — reverse proxies in front of the app (default 1:
# Traefik). Client IPs (rate limits, audit rows) are the N-th
# X-Forwarded-For entry from the right; 0 = use the socket address.
# The sync server reads TRUSTED_PROXY_HOPS. See shared/utils/clientIp.ts.
#
# SYNC_MAX_MESSAGE_BYTES / SYNC_MAX_UPDATE_BYTES / SYNC_MAX_DOCUMENT_BYTES —
# sync-server limits on what one client may push (bytes). A WebSocket frame
# above the first is refused outright (close 1009); an update above the
# second, or one that would grow the encoded document past the third, is
# rejected and that editor sees a "changes were not saved" banner.
# Deletions are always accepted so an oversized document can be trimmed.
# Defaults: 17825792 (17 MiB) / 16777216 (16 MiB) / 16777216 (16 MiB) — twice
# the editor's 8 MB "critical" size warning. See sync-server/src/limits.ts.
#
# SYNC_MAX_PREAUTH_BYTES / SYNC_MAX_PREAUTH_TOTAL_BYTES / SYNC_AUTH_TIMEOUT_MS —
# messages a connection sends for a document before it has authenticated
# are held in memory. A connection holding more than the first (bytes), or
# all connections together more than the second, is closed; so is one that
# sends messages for a document without its login token within the third
# (milliseconds). Defaults: 33554432 (32 MiB) / 268435456 (256 MiB) / 15000.
# See sync-server/src/pre-auth-guard.ts.
#
# NITRO_MAX_REQUEST_BODY_BYTES — largest request body the app server
# accepts on any route (default 53477376 = 51 MiB: a 50 MB document
# import plus form framing). Enforced by Bun before the body is buffered
# (server/runtime/bunEntry.ts).
#
# NUXT_LEGAL_* — operator identity rendered into the legal pages (only with
# the surfaces on); NUXT_LEGAL_ABUSE_CONTACT_EMAIL also receives abuse-report
# notifications on any instance.
# ─────────────────────────────────────────────────────────────────────
# NUXT_LEGAL_SURFACES_ENABLED=false
# NUXT_PRODUCT_TOUR_ENABLED=false
# NUXT_TRUSTED_PROXY_HOPS=1
# SYNC_MAX_MESSAGE_BYTES=17825792
# SYNC_MAX_UPDATE_BYTES=16777216
# SYNC_MAX_DOCUMENT_BYTES=16777216
# SYNC_MAX_PREAUTH_BYTES=33554432
# SYNC_MAX_PREAUTH_TOTAL_BYTES=268435456
# SYNC_AUTH_TIMEOUT_MS=15000
# NUXT_LEGAL_CONTROLLER_NAME=
# NUXT_LEGAL_ABUSE_CONTACT_EMAIL=

# Public origin of this deployment, used for absolute links in emails
# (waitlist confirm/unsubscribe) — never derived from the request Host.
# REQUIRED in production (NODE_ENV=production refuses to boot without it);
# in local dev, unset = those emails are skipped. docker-compose.prod.yml
# pins it to https://${DOMAIN}; the self-host compose to MARKOTO_PUBLIC_URL.
# Also the signal that keeps TEST_MODE=1 (test suite only) from ever
# activating on a real deployment: with a non-local NUXT_SITE_URL the app
# refuses to boot if TEST_MODE=1 is set.
# NUXT_SITE_URL=https://markoto.example.com

# ─────────────────────────────────────────────────────────────────────
# Stripe billing — ONLY needed when NUXT_BILLING_ENABLED=true.
#   With billing on, server/plugins/01-validate-secrets.ts hard-fails at
#   boot without the secret + webhook secret when NODE_ENV=production
#   (exactly as strict as before billing became switchable). The three
#   price ids map plan tiers to Stripe Prices (Stripe dashboard →
#   Products). With billing off (the default) leave all of them blank —
#   no code path touches Stripe.
# ─────────────────────────────────────────────────────────────────────
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_PRICE_PRO=
NUXT_STRIPE_PRICE_MAX=
NUXT_STRIPE_PRICE_ULTRA=
# Optional — override the Stripe API base (e.g. stripe-mock in tests).
# Must be a valid URL if set; a typo would silently hit real Stripe, so
# the validator rejects an unparseable value rather than falling back.
# NUXT_STRIPE_API_BASE=

# Optional — set to 1 to enable Stripe Tax on Checkout (automatic_tax,
# required billing address, VAT-id collection for B2B reverse charge).
# ONLY flip this after activating Stripe Tax + configuring the origin
# address in the Stripe dashboard — automatic_tax hard-errors otherwise.
# Part of the live-mode launch checklist.
# NUXT_STRIPE_AUTOMATIC_TAX=1

# ─────────────────────────────────────────────────────────────────────
# Optional — transactional email (Resend). Powers:
#   - account.delete_requested / cancelled / executed confirmations
#   - data_export.ready download links
#   - consent.version_bump re-acceptance prompts (forthcoming)
#   - breach.notification (legal — required only if a breach occurs)
#
# Without RESEND_API_KEY set, `server/utils/email/sendEmail.ts`
# falls back to a console log (`[email-stub]`). Setting RESEND_API_KEY
# alone is enough to flip into real delivery; provider auto-detection
# matches Resend's own SDK convention.
#
# NUXT_EMAIL_FROM defaults to Resend's sandbox sender
# `onboarding@resend.dev`, which delivers ONLY to the Resend account
# owner's verified email — fine for local testing. Set NUXT_EMAIL_FROM
# to a verified-domain address for production (requires SPF + DKIM
# DNS records configured in the Resend dashboard).
#
# To explicitly disable delivery despite the key being set
# (useful in staging environments), use NUXT_EMAIL_PROVIDER=stub.
# ─────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
# NUXT_EMAIL_FROM=markoto <noreply@your-domain.app>
# NUXT_EMAIL_PROVIDER=stub  # opt-out override

# ─────────────────────────────────────────────────────────────────────
# Optional — admin allowlist. Comma-separated, case-insensitive list
# of user emails that get access to /admin/* (today: the abuse-
# reports queue at /admin/abuse-reports). The "Admin" entry in the
# avatar dropdown only surfaces for these users. Empty / unset =
# no admins, every admin endpoint returns 403.
# ─────────────────────────────────────────────────────────────────────
# NUXT_ADMIN_USER_EMAILS=admin@example.com,founder@example.com

# ─────────────────────────────────────────────────────────────────────
# Optional — tier-cap overrides. The committed values in
# `shared/config/tiers.ts` are the self-hoster defaults; any individual
# cap can be overridden at runtime without a rebuild. Key shape:
#   TIER_<FREE|PRO|MAX|ULTRA>_<FIELD>
# with FIELD one of LITELLM_BUDGET_USD, WORKSPACES_OWNED,
# KNOWLEDGE_FILES, KNOWLEDGE_BYTES_PER_WORKSPACE,
# KNOWLEDGE_BYTES_PER_USER, IMAGE_BYTES_PER_USER. Only positive finite
# numbers are accepted; anything else silently keeps the default. With
# billing OFF every account is on the FREE tier, so the TIER_FREE_*
# values are the limits everyone gets — self-hosters paying their own
# model-provider bills typically raise them (docker-compose.prod.yml
# passes the six TIER_FREE_* vars through to the app container):
# ─────────────────────────────────────────────────────────────────────
# TIER_FREE_LITELLM_BUDGET_USD=100
# TIER_FREE_WORKSPACES_OWNED=50
# TIER_FREE_KNOWLEDGE_FILES=500
# TIER_FREE_KNOWLEDGE_BYTES_PER_WORKSPACE=1073741824
# TIER_FREE_KNOWLEDGE_BYTES_PER_USER=10737418240
# Document images (uploads, AI-generated images, copies made by
# duplicating a doc) per user; pending uploads count too. Default
# 100 MiB on free.
# TIER_FREE_IMAGE_BYTES_PER_USER=10737418240
# The AI budget is applied to a user's LiteLLM virtual key when the key is
# created (first AI use); a changed TIER_FREE_LITELLM_BUDGET_USD reaches
# existing keys at the next app start (litellm-key-reconcile, also every 6 h).
#
# Optional — global monthly ceiling (USD) on platform-paid AI for ALL
# free-tier users together, enforced by LiteLLM as a team budget (team
# `markoto-free-tier`; every free key is a member). When it is used up,
# free users get "This month's free AI allowance is used up" until the
# monthly reset; own-key (BYOK) calls are not affected. Empty / 0 = no
# ceiling (default). The hosted SaaS uses 500.
# NUXT_FREE_TIER_TOTAL_BUDGET_USD=500

# Optional — image garbage collection. A confirmed doc image that is
# referenced nowhere (its doc, any version the activity log can still
# restore, another doc, a theme, a comment) for this many days in a row
# is deleted, freeing the uploader's image quota. Default 30; 0 turns
# the GC off.
# NUXT_IMAGE_GC_RETENTION_DAYS=30

# ═════════════════════════════════════════════════════════════════════
# Production deploy only (docker-compose.prod.yml). Skip in dev.
# ═════════════════════════════════════════════════════════════════════

# Traefik / ACME
DOMAIN=
ACME_EMAIL=

# GHCR image source — pin a tag, no implicit "latest".
REGISTRY=
IMAGE_TAG=

# Backup sidecar tunables. No defaults — set explicitly.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=30

# Symmetric AES-256 passphrase for client-side backup encryption (gpg).
# Generate with: openssl rand -base64 48
# IMPORTANT — rotation tradeoff: rotating this value invalidates EVERY
# backup taken under the old passphrase for restore purposes (we can't
# decrypt them without the old passphrase). Plan rotations against your
# retention window: if you keep 30 days of backups, rotating means
# accepting a 30-day window where older backups are unrecoverable. For
# most deployments this is fine — backups serve disaster-recovery from
# the recent past — but if you need long-tail restore, save outgoing
# passphrases to a separate vault before rotating.
BACKUP_GPG_PASSPHRASE=

# Backup storage — used ONLY by the backup sidecar (and the restore drill).
# Leave empty to keep writing backups into the app's bucket with the app's
# S3 credentials (NUXT_S3_*). For production, point these at a dedicated
# bucket (versioning + object lock) with a key scoped to that bucket, so a
# leaked app key can't delete or read backups. See docs/LAUNCH-CHECKLIST.md.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=

# Optional — Postgres TLS root CA (cert-pin verification). Path to a PEM
# file readable by the app + sync containers. When set, the pg client
# verifies the managed-Postgres server cert against this CA instead of
# the system bundle (defends against a compromised public CA issuing a
# rogue cert for your provider's hostname). When unset in production,
# verification still happens against the system CA bundle — adequate
# for most managed providers.
# OVH managed PG: download the CA from the cluster's "Connections" tab,
# bind-mount into the app + sync containers (e.g. via compose volume),
# point this at the in-container path. See docs/DEPLOY.md.
# PGSSLROOTCERT=/run/secrets/managed_pg_ca.pem
# Explicit opt-out from TLS-in-transit. Almost never wanted in prod;
# set only during a managed-PG migration where the provider's network
# edge handles TLS termination instead.
# PGSSL=disable

# ─────────────────────────────────────────────────────────────────────
# Managed Postgres (prod). Defaults run the in-stack postgres container.
# To point the whole stack (app, sync, litellm, db-init, backup) at a
# managed cluster instead, set ALL of:
#   POSTGRES_HOST / POSTGRES_PORT — the cluster endpoint
#   POSTGRES_SSLMODE=require      — libpq-style; feeds litellm's
#                                   DATABASE_URL, db-init's psql, and
#                                   the backup sidecar's pg_dump
#   PGSSLROOTCERT                 — CA path (see above; Ansible uploads
#                                   infra/files/ovh-pg-ca.pem to
#                                   /opt/markoto/secrets/ when
#                                   ovh_pg_host is set)
# The user needs CREATEDB rights (litellm database bootstrap). The
# in-stack postgres container still runs idle in this mode — compose
# `include:` cannot drop a service; accepted overhead.
# POSTGRES_HOST=my-cluster.database.cloud.ovh.net
# POSTGRES_PORT=20184
# POSTGRES_SSLMODE=require
