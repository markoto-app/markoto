# markoto — environment template.
#
# Two scenarios share this file. Skip the section that doesn't apply.
#
#   1) Daily dev: `docker compose -f docker-compose.dev.yml up -d` (infra only)
#      + `bun run dev` on the host. The connection strings under "App ↔ infra"
#      below are wired to the hardcoded credentials in docker-compose.dev.yml
#      — match them verbatim.
#
#   2) Prod deploy via docker-compose.prod.yml. The compose file builds
#      DATABASE_URL / VALKEY_URL from POSTGRES_PASSWORD + VALKEY_PASSWORD
#      inline, so leave those two URL lines blank in prod and fill the
#      "Production deploy only" block at the bottom.
#
# Policy: no shell-default fallbacks (`${X:-default}`) in any compose file.
# Either set a value here or the stack refuses to start. server/plugins/01-validate-secrets.ts
# enforces presence at app boot for every required NUXT_* below.

# ─────────────────────────────────────────────────────────────────────
# Required — app secrets (≥32 chars each; `openssl rand -hex 32`)
# ─────────────────────────────────────────────────────────────────────
NUXT_SESSION_PASSWORD=
NUXT_JWT_SECRET=
NUXT_INTERNAL_API_SECRET=

# Optional, only set during a rotation window — see docs/SECRETS-ROTATION.md.
NUXT_JWT_SECRET_PREVIOUS=
NUXT_INTERNAL_API_SECRET_PREVIOUS=

# ─────────────────────────────────────────────────────────────────────
# Required — Postgres + Valkey, atomic parts. shared/utils/connectionStrings.ts
# composes the actual DATABASE_URL/VALKEY_URL on demand so .env never
# carries a composed URL alongside the parts that built it.
#
# DEV (host bun + docker-compose.dev.yml infra): use the values shown —
# *_HOST is `localhost` because bun runs on the host and reaches the
# containers via published ports.
# PROD/LOCAL (containerised app): the compose file overrides *_HOST to
# the docker service name (`postgres`, `valkey`) inline; .env still owns
# the credentials.
# ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=ypad
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=ypad
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

VALKEY_HOST=localhost
VALKEY_PORT=6379
# DEV/TEST: defaults to `devpassword` in docker-compose.dev.yml /
# .test.yml; match that here so `bun run dev` on the host can authenticate
# to the container. PROD/LOCAL compose files force this with `:?required`
# — generate with `openssl rand -hex 32`.
VALKEY_PASSWORD=devpassword
# Logical DB index. Default 0 is fine; bump to isolate keyspaces.
VALKEY_DB=0
# Optional — Valkey TLS opt-in. Leave `false` for self-hosted single-VPS
# deploys: the docker network IS the trust boundary and TLS is overkill.
# Set `true` if Valkey is on a different host or behind a managed-Redis
# provider (Infomaniak managed Valkey, AWS ElastiCache, OVH Redis-as-a-
# service, etc.). When true, the client uses ioredis's TLS support against
# the system CA store; provide VALKEY_TLS_CA_PATH only if the provider
# uses a private CA. See docs/SECURITY-HARDENING.md.
VALKEY_TLS_ENABLED=false
# VALKEY_TLS_CA_PATH=/path/to/provider-ca.pem

# ─────────────────────────────────────────────────────────────────────
# Required — other app ↔ infra endpoints.
# DEV: leave the values exactly as shown — they match docker-compose.dev.yml.
# ─────────────────────────────────────────────────────────────────────
NUXT_S3_ENDPOINT=http://localhost:8333
NUXT_S3_ACCESS_KEY=ypad-access-key
NUXT_S3_SECRET_KEY=ypad-secret-key
NUXT_S3_BUCKET=ypad

NUXT_MARKITDOWN_URL=http://localhost:8080
NUXT_SYNC_INTERNAL_URL=http://localhost:4001
NUXT_PUBLIC_SYNC_URL=ws://localhost:4001
# Backend renderer container — Playwright + Chromium that produces PDFs and
# per-page PNGs. Internal-network only in compose; empty in dev disables the
# user-facing /api/docs/:id/pdf endpoint and the AI's view_pages tool.
NUXT_RENDERER_INTERNAL_URL=http://localhost:9000

# ─────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────
# Required — LiteLLM proxy. Phase 5: every AI surface (embeddings, text
# loop, image gen, transcribe, dictate ticks) routes through this single
# gateway. The master key authenticates admin + virtual-key APIs;
# per-user virtual keys are minted lazily on first AI call.
#
# Generate strong values:
#   LITELLM_MASTER_KEY=sk-$(openssl rand -hex 32)
#   LITELLM_SALT_KEY=sk-$(openssl rand -hex 32)
# ─────────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
NUXT_LITELLM_URL=http://litellm:4000
NUXT_LITELLM_MASTER_KEY=

# AI provider keys. MISTRAL_API_KEY + BFL_API_KEY are consumed by LiteLLM
# only (the proxy multiplexes them per model in infra/litellm/config.yaml).
# JINA_AI_API_KEY is used BOTH by LiteLLM (embeddings) AND directly by the
# Nuxt app process (the fetch_url tool's Jina Reader call), so it must be
# present in the app container env, not just the litellm container.
JINA_AI_API_KEY=
MISTRAL_API_KEY=
BFL_API_KEY=
# Staan (staan.ai) — European web-search index backing the web_search tool.
# Read directly by the Nuxt app process. Enable EU-only routing (disable the
# US fallback) in the Staan dashboard; there is no per-request parameter.
STAAN_API_KEY=

# Optional — distinct JWT secret for the dictation WS so a compromised
# Hocuspocus secret can't forge dictation tokens (and vice versa).
# Falls back to NUXT_JWT_SECRET when empty (fine for dev).
NUXT_AI_DICTATE_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Optional — OAuth (login). Empty pair = anonymous-only deploy.
# Pair-validated at boot: id + secret per provider must be both-or-neither.
# ─────────────────────────────────────────────────────────────────────
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Optional — model + tunable overrides. nuxt.config.ts holds the defaults
# (see AGENTS.md §7 for rationale). Uncomment only to override.
# ─────────────────────────────────────────────────────────────────────
# NUXT_LITELLM_TEXT_MODEL=mistral-small-2603
# NUXT_LITELLM_EMBEDDINGS_MODEL=jina-embeddings-v5-text-nano
# NUXT_LITELLM_EMBEDDINGS_DIMS=768
# NUXT_LITELLM_TRANSCRIBE_MODEL=voxtral-mini-transcribe
# NUXT_LITELLM_REALTIME_TICK_MODEL=voxtral-realtime-tick
# NUXT_INACTIVE_DOC_TTL_DAYS=180
# NUXT_PUBLIC_DOCS_CHROME_DOMAIN=markoto.app
# Slow-query threshold (ms). Queries above this fire a warning-level
# Sentry event (component=db, event=slow_query). Default 200.
# NUXT_DB_SLOW_QUERY_MS=200

# ─────────────────────────────────────────────────────────────────────
# Optional — Sentry (sentry.io). Empty in dev keeps telemetry silent.
# In prod, create a Sentry project, copy its DSN here, then redeploy.
# ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SENTRY_DSN=
# Optional — separate backend-only DSN if you want browser vs server
# in distinct Sentry projects. When empty, the server uses
# NUXT_PUBLIC_SENTRY_DSN for both.
SENTRY_DSN=

# Optional — BUILD-TIME only. Used by @sentry/nuxt's source-map upload
# during `bun run build`. Without these three, frontend stack traces
# arrive minified and the build still succeeds — but on-call has to
# map line numbers by hand. Set in CI / build env, NOT in the runtime
# `app` container. See docs/DEPLOY.md.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────────────
# Stripe billing — REQUIRED in production, unused in dev.
#   docker-compose.prod.yml passes all five with `:?required`, and
#   server/plugins/01-validate-secrets.ts hard-fails at boot without the
#   secret + webhook secret when NODE_ENV=production. The three price ids
#   map plan tiers to Stripe Prices (see the Stripe dashboard → Products).
#   Leave blank for dev/local: TEST_MODE=1 bypasses billing entirely.
# ─────────────────────────────────────────────────────────────────────
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_PRICE_PRO=
NUXT_STRIPE_PRICE_MAX=
NUXT_STRIPE_PRICE_ULTRA=
# Optional — override the Stripe API base (e.g. stripe-mock in tests).
# Must be a valid URL if set; a typo would silently hit real Stripe, so
# the validator rejects an unparseable value rather than falling back.
# NUXT_STRIPE_API_BASE=

# Optional — set to 1 to enable Stripe Tax on Checkout (automatic_tax,
# required billing address, VAT-id collection for B2B reverse charge).
# ONLY flip this after activating Stripe Tax + configuring the origin
# address in the Stripe dashboard — automatic_tax hard-errors otherwise.
# Part of the live-mode launch checklist.
# NUXT_STRIPE_AUTOMATIC_TAX=1

# ─────────────────────────────────────────────────────────────────────
# Optional — transactional email (Resend). Powers:
#   - account.delete_requested / cancelled / executed confirmations
#   - data_export.ready download links
#   - consent.version_bump re-acceptance prompts (forthcoming)
#   - breach.notification (legal — required only if a breach occurs)
#
# Without RESEND_API_KEY set, `server/utils/email/sendEmail.ts`
# falls back to a console log (`[email-stub]`). Setting RESEND_API_KEY
# alone is enough to flip into real delivery; provider auto-detection
# matches Resend's own SDK convention.
#
# NUXT_EMAIL_FROM defaults to Resend's sandbox sender
# `onboarding@resend.dev`, which delivers ONLY to the Resend account
# owner's verified email — fine for local testing. Set NUXT_EMAIL_FROM
# to a verified-domain address for production (requires SPF + DKIM
# DNS records configured in the Resend dashboard).
#
# To explicitly disable delivery despite the key being set
# (useful in staging environments), use NUXT_EMAIL_PROVIDER=stub.
# ─────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
# NUXT_EMAIL_FROM=markoto <noreply@your-domain.app>
# NUXT_EMAIL_PROVIDER=stub  # opt-out override

# ─────────────────────────────────────────────────────────────────────
# Optional — admin allowlist. Comma-separated, case-insensitive list
# of user emails that get access to /admin/* (today: the abuse-
# reports queue at /admin/abuse-reports). The "Admin" entry in the
# avatar dropdown only surfaces for these users. Empty / unset =
# no admins, every admin endpoint returns 403.
# ─────────────────────────────────────────────────────────────────────
# NUXT_ADMIN_USER_EMAILS=admin@example.com,founder@example.com

# ─────────────────────────────────────────────────────────────────────
# Optional — tier-cap overrides. The committed values in
# `shared/config/tiers.ts` are the self-hoster defaults; any individual
# cap can be overridden at runtime without a rebuild. Key shape:
#   TIER_<FREE|PRO|MAX|ULTRA>_<FIELD>
# with FIELD one of LITELLM_BUDGET_USD, WORKSPACES_OWNED,
# KNOWLEDGE_FILES, KNOWLEDGE_BYTES_PER_WORKSPACE,
# KNOWLEDGE_BYTES_PER_USER. Only positive finite numbers are accepted;
# anything else silently keeps the default. Self-hosters paying their
# own model-provider bills typically raise the free-tier AI budget:
# ─────────────────────────────────────────────────────────────────────
# TIER_FREE_LITELLM_BUDGET_USD=100
# TIER_FREE_WORKSPACES_OWNED=50
# TIER_FREE_KNOWLEDGE_FILES=500

# ═════════════════════════════════════════════════════════════════════
# Production deploy only (docker-compose.prod.yml). Skip in dev.
# ═════════════════════════════════════════════════════════════════════

# Traefik / ACME
DOMAIN=
ACME_EMAIL=

# GHCR image source — pin a tag, no implicit "latest".
REGISTRY=
IMAGE_TAG=

# Backup sidecar tunables. No defaults — set explicitly.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=30

# Symmetric AES-256 passphrase for client-side backup encryption (gpg).
# Generate with: openssl rand -base64 48
# IMPORTANT — rotation tradeoff: rotating this value invalidates EVERY
# backup taken under the old passphrase for restore purposes (we can't
# decrypt them without the old passphrase). Plan rotations against your
# retention window: if you keep 30 days of backups, rotating means
# accepting a 30-day window where older backups are unrecoverable. For
# most deployments this is fine — backups serve disaster-recovery from
# the recent past — but if you need long-tail restore, save outgoing
# passphrases to a separate vault before rotating.
BACKUP_GPG_PASSPHRASE=

# Optional — Postgres TLS root CA (cert-pin verification). Path to a PEM
# file readable by the app + sync containers. When set, the pg client
# verifies the managed-Postgres server cert against this CA instead of
# the system bundle (defends against a compromised public CA issuing a
# rogue cert for your provider's hostname). When unset in production,
# verification still happens against the system CA bundle — adequate
# for most managed providers.
# OVH managed PG: download the CA from the cluster's "Connections" tab,
# bind-mount into the app + sync containers (e.g. via compose volume),
# point this at the in-container path. See docs/DEPLOY.md.
# PGSSLROOTCERT=/run/secrets/managed_pg_ca.pem
# Explicit opt-out from TLS-in-transit. Almost never wanted in prod;
# set only during a managed-PG migration where the provider's network
# edge handles TLS termination instead.
# PGSSL=disable
