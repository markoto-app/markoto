# Production deploy: the domain you control. DNS A records for ${DOMAIN} and
# sync.${DOMAIN} must point at the VPS. See docs/DEPLOY.md.
DOMAIN=yourdomain.com
ACME_EMAIL=you@yourdomain.com
# GHCR image source for docker-compose.prod.yml. Tag `latest` is fine for
# single-environment ops; pin to a specific tag (e.g. v1.2.3) for rollbacks.
REGISTRY=ghcr.io/joelbarmettleruzh
IMAGE_TAG=latest
SESSION_PASSWORD=your-super-secure-password-with-at-least-32-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTGRES_PASSWORD=change-me-to-a-strong-password
# S3 — production points to Infomaniak / R2 / AWS. Dev uses the SeaweedFS
# service in docker-compose.dev.yml (http://seaweedfs:8333 inside the network).
S3_ENDPOINT=https://s3.pub1.infomaniak.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ypad
JWT_SECRET=change-me-to-something-random-64-chars
INTERNAL_API_SECRET=change-me-to-something-random-used-between-app-and-sync-server
GOOGLE_API_KEY=
# Model for the agentic prompt loop (tool orchestration, web_search grounding, multi-edit).
# gemini-3.1-flash-lite-preview: $0.25/1M in, $1.50/1M out. Grounding: 5,000 prompts/month
# free (shared across Gemini 3 family), then $14 per 1,000 searches.
GOOGLE_MODEL=gemini-3.1-flash-lite-preview
# Model for inline selection rewrites — one-shot, no tools, so cheapest viable tier wins.
# gemini-2.5-flash-lite: $0.10/1M in, $0.40/1M out.
GOOGLE_REWRITE_MODEL=gemini-2.5-flash-lite
# Backup tuning. Defaults: 86400s (24h) interval, keep 30 newest.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=30
