# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# SQLite dev DB (auto-migrated on startup — never commit binary state)
/data/*.db
/data/*.db-shm
/data/*.db-wal

# Claude Code local scheduler state
/.claude/

# Vitest coverage reports — regenerated via `bun run test:coverage`
/coverage/

# Playwright per-run artifacts (traces, failure context, raw flow output).
# Manifests + screenshots that the docs SHIP live in public/flows/ — those
# are committed. Per-run artifacts are not.
/test-results/
/playwright-report/
/tests/e2e/output/

# act local-testing secrets (`act --secret-file .secrets`). Never commit.
.secrets
*.secrets

.mcp.json

# OVH OpenStack credentials (contains OS_PASSWORD) — never commit
openrc.sh
*openrc*
.env.staging-openrc
.eslintcache

# Managed private instance: the customer logo (deploy/compose/compose.selfhost.brand.yml)
/branding/

__pycache__/
*.pyc
