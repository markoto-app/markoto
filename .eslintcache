torView} from '@codemirror/view';\nimport {",{"kind":"8623","justification":"8624"},{"kind":"8623","justification":"8624"},[0,1406],"import { describe, it, expect, vi } from 'vitest'\nimport { mockNuxtImport } from '@nuxt/test-utils/runtime'\nimport { nextTick } from 'vue'\nimport * as Y from 'yjs'\nimport { Awareness } from 'y-protocols/awareness'\nimport type { SerializedAnchor } from '../../app/utils/commentAnchors'\n\n// eslint-disable-next-line import/first -- mockNuxtImport must be hoisted above the import it mocks\nimport { useComments } from '~/composables/useComments'\n\n// Composable wrapping the Y.Array<Y.Map> \"comments\" structure. Tests\n// cover:\n//   - empty initial state\n//   - createComment writes a new entry, derives correctly on the next tick\n//   - active vs orphaned classification (anchor null → orphan, sorted last)\n//   - reply lifecycle via observeDeep\n//   - resolved/delete flag flips\n//\n// Author identity is read from awareness; we stamp a name on the local\n// state before the call so the deriver doesn't fall back to \"Anonymous\".\n//\n// Editing comments is intentionally NOT supported (product decision —\n// users can only delete their own / resolve threads). No tests for an\n// edit path.\n\nconst { sessionState } = vi.hoisted(() => ({\n  sessionState: {\n    loggedIn: { value: true },\n    user: { value: { id: 1, name: 'Alice' } as { id: number, name?: string } | null }\n  }\n}))\n\nmockNuxtImport('useUserSession', () => {\n  return () => ({\n    loggedIn: sessionState.loggedIn,\n    user: sessionState.user\n  })\n})",{"kind":"8623","justification":"8633"},{"messageId":"8634","fix":"8635","desc":"8636"},{"messageId":"8637","fix":"8638","desc":"8639"},{"kind":"8623","justification":"8624"},{"kind":"8623","justification":"8624"},[1047,1047],"\n\n",{"kind":"8623","justification":"8624"},"directive","","test intentionally exercises missing-key detection across all theme sections","replaceEmptyInterface",{"replacement":"8640"},{"range":"8641","text":"8642"},"Replace empty interface with `object`.",{"replacement":"8643"},{"range":"8644","text":"8645"},"Replace empty interface with `unknown`.","mockNuxtImport must be hoisted above the import it mocks","suggestUnknown",{"range":"8646","text":"8643"},"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct.","suggestNever",{"range":"8647","text":"8648"},"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of.","object",[1834,1864],"type SecureSessionData = object","unknown",[1834,1864],"type SecureSessionData = unknown",[2465,2468],[2465,2468],"never"]