{
  "name": "markoto",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Joel Barmettler",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run --project=unit --project=dom --project=nuxt",
    "test:unit": "vitest run --project=unit",
    "test:dom": "vitest run --project=dom",
    "test:nuxt": "vitest run --project=nuxt",
    "test:repos": "vitest run --project=repos",
    "test:integration": "vitest run --project=integration",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:fast": "vitest run --project=unit --project=dom --project=nuxt --project=repos --coverage",
    "test:watch": "vitest --project=unit --project=dom --project=nuxt",
    "test:integration:up": "SYNC_TEST_APP_URL=http://host.docker.internal:3101 docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "flows:test:against-running": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://localhost:3000} playwright test",
    "flows:test:against-running:en": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://localhost:3000} playwright test --project=en-light --project=en-dark",
    "flows:test": "bun scripts/flows-ephemeral.ts",
    "flows:test:changed": "bun scripts/flows-test-changed.ts",
    "flows:build": "bun scripts/build-flows.ts",
    "flows": "bun run flows:test && bun run flows:build",
    "flows:up": "docker compose -f docker-compose.test.yml --profile flows up -d --wait",
    "flows:down": "docker compose -f docker-compose.test.yml --profile flows down -v"
  },
