    "@mdit/plugin-mark": "^0.23.2",
    "@mdit/plugin-sub": "^0.24.2",
    "@mdit/plugin-sup": "^0.24.2",
    "@mistralai/mistralai": "^2.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@node-saml/node-saml": "5.2.0",
    "@nuxt/content": "^3.16.2",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/mcp-toolkit": "^0.24.2",
    "@pinia/colada-nuxt": "^1.2.0",
    "@pinia/nuxt": "^1.0.3",
    "@sentry/nuxt": "^10.76.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "altcha": "3.4.1",
