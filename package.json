{
  "name": "markoto",
  "version": "0.1.0",
  "description": "Collaborative markdown editor with live CRDT sync, paged WYSIWYG preview, server-rendered PDF export, and EU-resident AI writing assistance",
  "homepage": "https://markoto.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markoto-app/markoto.git"
  },
  "bugs": {
    "url": "https://github.com/markoto-app/markoto/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "collaboration",
    "crdt",
    "yjs",
    "hocuspocus",
    "nuxt",
    "pdf",
    "ai"
  ],
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "LatentSpace Labs GmbH",
  "workspaces": [
    "shared",
    "sync-server",
    "renderer"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fast": "LINT_TYPES=off eslint .",
    "lint:types": "LINT_TYPES=only eslint .",
    "typecheck": "nuxt typecheck",
    "typecheck:guard": "node scripts/check-typecheck-covers-vue.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-migrations": "bun scripts/check-destructive-migrations.ts",
    "db:check-drift": "node scripts/checks/migration-drift.mjs",
    "knowledge:reembed": "bun scripts/reembed-knowledge.ts",
    "secrets:reencrypt": "bun scripts/reencrypt-secrets.ts",
    "smoke": "playwright test --config=tests/smoke/playwright.config.ts",
    "test": "vitest run --project=unit --project=dom --project=nuxt",
    "test:unit": "vitest run --project=unit",
    "test:dom": "vitest run --project=dom",
    "test:nuxt": "vitest run --project=nuxt",
    "test:repos": "vitest run --project=repos",
    "test:integration": "vitest run --project=integration",
    "test:billing-sandbox": "vitest run --project=billing-sandbox",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:fast": "vitest run --project=unit --project=dom --project=nuxt --project=repos --coverage",
    "test:watch": "vitest --project=unit --project=dom --project=nuxt",
    "test:integration:up": "SYNC_TEST_APP_URL=http://host.docker.internal:3101 bash scripts/test-compose.sh up -d --wait",
    "test:integration:down": "bash scripts/test-compose.sh down -v",
    "flows:test:against-running": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-http://localhost:3000} playwright test",
    "flows:test": "bun scripts/flows-ephemeral.ts",
    "flows:test:changed": "bun scripts/flows-test-changed.ts",
    "flows:build": "bun scripts/build-flows.ts",
    "flows": "bun run flows:test && bun run flows:build",
    "flows:up": "bash scripts/test-compose.sh --profile flows up -d --wait",
    "flows:down": "bash scripts/test-compose.sh --profile flows down -v",
    "tour:capture": "bun scripts/capture-tour.ts",
    "typecheck:tests": "vue-tsc --noEmit -p tsconfig.tests.json",
    "typecheck:scripts": "vue-tsc --noEmit -p tsconfig.scripts.json",
    "knip": "knip --no-progress",
    "depcruise": "bun --bun x depcruise --config .dependency-cruiser.cjs app server shared modules scripts sync-server/src renderer/src tests",
    "env:gen": "bun scripts/env-gen.ts",
    "check": "bun run check:env && bun run check:md-paths && bun run check:vocab && bun run check:em-dash && bun run db:check-drift && bun run depcruise && bun run knip && bun run lint:fast && bun run typecheck && bun run typecheck:guard && bun run typecheck:tests && bun run typecheck:scripts && bun run typecheck:services && bun run test:unit",
    "check:tools": "bun run check:shell && bun run check:docker && bun run check:links && bun run check:py && bun run check:pyright",
    "check:full": "bun run check && bun --bun run lint:types && bun run check:tools",
    "typecheck:services": "bun --bun run --filter markoto-sync-server --filter markoto-renderer typecheck",
    "check:env": "bun scripts/env-gen.ts --check",
    "check:md-paths": "bun scripts/checks/md-paths.mjs",
    "check:vocab": "bun scripts/checks/internal-vocabulary.mjs",
    "check:em-dash": "bun scripts/checks/no-em-dash.mjs",
    "check:i18n-unused": "bun scripts/checks/i18n-unused-keys.mjs",
    "check:py": "uvx ruff@0.17.4 check && uvx ruff@0.17.4 format --check",
    "check:pyright": "uv run --no-project --python 3.13 --with pyright==1.1.414 --with fastapi==0.162.0 --with markitdown[all]==0.1.9 --with uvicorn[standard]==0.54.0 --with httpx pyright",
    "check:shell": "shellcheck $(git ls-files '*.sh')",
    "check:docker": "hadolint --config .hadolint.yaml $(git ls-files '*Dockerfile')",
    "check:links": "lychee --config lychee.toml $(git ls-files '*.md' ':!:content' ':!:tests/fixtures' ':!:CHANGELOG.md' ':!:shared/templates/content')"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@codemirror/commands": "^6.11.1",
