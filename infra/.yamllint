---
# yamllint config for the markoto Ansible tree.
# 120-col line length matches the rest of the codebase (TS source uses Prettier 100;
# Ansible YAML quoting + jinja templating routinely overshoots 80 cols, so 120 is the
# pragmatic ceiling here. We still warn at 120 to flag genuine egregious lines).
extends: default

rules:
  line-length:
    max: 120
    level: warning
  # Allow `{ key: value }` and `{{ var }}` without yelling. The defaults are too strict
  # for Ansible's loop dicts and jinja interpolation patterns.
  braces:
    max-spaces-inside: 1
    level: warning
  # Trailing comments and document-start markers are stylistic.
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  # ansible-lint requires these three settings — keep yamllint and ansible-lint
  # in lock-step so we don't get cross-tool warnings:
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .ansible/
  collections/
