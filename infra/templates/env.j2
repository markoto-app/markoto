{# Renders the .env file consumed by docker-compose.prod.yml.
   Every var in .env.example MUST be templated below; missing vault
   values raise an UndefinedError at render time.
   Values are written verbatim: unlike infra/render-env.sh (the CI deploy
   path, which single-quotes values containing $ # " \ or backticks and
   rejects newlines/single quotes) this template expects plain values. #}
# markoto .env — rendered by Ansible. Do not edit on the VPS;
# re-run `make deploy` after changing group_vars/.

# ─── App secrets ───
NUXT_SESSION_PASSWORD={{ nuxt_session_password }}
NUXT_JWT_SECRET={{ nuxt_jwt_secret }}
NUXT_INTERNAL_API_SECRET={{ nuxt_internal_api_secret }}
NUXT_JWT_SECRET_PREVIOUS={{ nuxt_jwt_secret_previous | default('') }}
NUXT_INTERNAL_API_SECRET_PREVIOUS={{ nuxt_internal_api_secret_previous | default('') }}

# ─── Postgres ───
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_HOST={{ postgres_host }}
POSTGRES_PORT={{ postgres_port }}
POSTGRES_APP_USER={{ postgres_app_user | default('') }}
POSTGRES_APP_PASSWORD={{ postgres_app_password | default('') }}
POSTGRES_LITELLM_USER={{ postgres_litellm_user | default('') }}
POSTGRES_LITELLM_PASSWORD={{ postgres_litellm_password | default('') }}

# ─── Valkey ───
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD={{ valkey_password }}
VALKEY_DB={{ valkey_db }}
VALKEY_TLS_ENABLED={{ valkey_tls_enabled | string | lower }}

# ─── S3 / object storage ───
NUXT_S3_ENDPOINT={{ nuxt_s3_endpoint }}
NUXT_S3_ACCESS_KEY={{ nuxt_s3_access_key }}
NUXT_S3_SECRET_KEY={{ nuxt_s3_secret_key }}
NUXT_S3_BUCKET={{ nuxt_s3_bucket }}

# ─── Internal service URLs (compose-network names) ───
NUXT_MARKITDOWN_URL=http://markitdown:8080
NUXT_SYNC_INTERNAL_URL=http://sync:4001
NUXT_PUBLIC_SYNC_URL=wss://sync.{{ domain }}
NUXT_RENDERER_INTERNAL_URL=http://renderer:9000

# ─── AI dictate JWT (Phase 5: every AI surface routes through LiteLLM) ───
NUXT_AI_DICTATE_JWT_SECRET={{ nuxt_ai_dictate_jwt_secret | default('') }}

# ─── LiteLLM proxy ───
# Master + salt authenticate the admin / virtual-key APIs and encrypt
# at-rest verification tokens. The compose file maps LITELLM_MASTER_KEY
# into the app's NUXT_LITELLM_MASTER_KEY and the litellm container's own env.
LITELLM_MASTER_KEY={{ litellm_master_key }}
LITELLM_SALT_KEY={{ litellm_salt_key }}

# ─── AI provider keys ───
# JINA + STAAN are read by the app process (fetch_url reader / web_search);
# MISTRAL + BFL are consumed by the litellm container. All four are required.
JINA_AI_API_KEY={{ jina_ai_api_key }}
STAAN_API_KEY={{ staan_api_key }}
MISTRAL_API_KEY={{ mistral_api_key }}
BFL_API_KEY={{ bfl_api_key }}

# ─── Web-tool allowance (calls/user; empty = default 30/hour, 100/day; 0 = unlimited) ───
NUXT_WEB_TOOLS_HOURLY_LIMIT={{ nuxt_web_tools_hourly_limit | default('') }}
NUXT_WEB_TOOLS_DAILY_LIMIT={{ nuxt_web_tools_daily_limit | default('') }}

# ─── Knowledge-base embeddings (self-hosting; empty = hosted defaults) ───
# Compose falls back to Jina v5-text-nano @ 768 for every empty value.
# docs/AI-MODELS.md#embeddings
NUXT_LITELLM_EMBEDDINGS_MODEL={{ nuxt_litellm_embeddings_model | default('') }}
NUXT_LITELLM_EMBEDDINGS_DIMS={{ nuxt_litellm_embeddings_dims | default('') }}
NUXT_LITELLM_EMBEDDINGS_SEND_DIMENSIONS={{ nuxt_litellm_embeddings_send_dimensions | default('') }}
NUXT_LITELLM_EMBEDDINGS_TASK_HINTS={{ nuxt_litellm_embeddings_task_hints | default('') }}
EMBEDDINGS_UPSTREAM_MODEL={{ embeddings_upstream_model | default('') }}
EMBEDDINGS_UPSTREAM_API_BASE={{ embeddings_upstream_api_base | default('') }}
EMBEDDINGS_UPSTREAM_API_KEY={{ embeddings_upstream_api_key | default('') }}

# ─── Bring-your-own-key AI (WP4) + free AI allowance ───
# Instance defaults per capability. Hosted: chat = the free-allowance alias
# (Z.ai GLM-5.3 Flash on Mistral's EU endpoint, infra/litellm/config.yaml;
# platform-paid, TIER_FREE_LITELLM_BUDGET_USD per user per month, capped in
# total by NUXT_FREE_TIER_TOTAL_BUDGET_USD); image / transcription empty
# (BYOK only). Same defaults as infra/render-env.sh. MODEL alone = a LiteLLM
# model alias (platform-paid); MODEL + BASE_URL + API_KEY = an
# OpenAI-compatible endpoint used like a user key.
NUXT_AI_DEFAULT_CHAT_MODEL={{ nuxt_ai_default_chat_model | default('zai-glm-5-3-flash') }}
NUXT_AI_DEFAULT_CHAT_BASE_URL={{ nuxt_ai_default_chat_base_url | default('') }}
NUXT_AI_DEFAULT_CHAT_API_KEY={{ nuxt_ai_default_chat_api_key | default('') }}
NUXT_AI_DEFAULT_CHAT_VISION={{ nuxt_ai_default_chat_vision | default('true') | string | lower }}
NUXT_AI_DEFAULT_IMAGE_MODEL={{ nuxt_ai_default_image_model | default('') }}
NUXT_AI_DEFAULT_IMAGE_BASE_URL={{ nuxt_ai_default_image_base_url | default('') }}
NUXT_AI_DEFAULT_IMAGE_API_KEY={{ nuxt_ai_default_image_api_key | default('') }}
NUXT_AI_DEFAULT_TRANSCRIBE_MODEL={{ nuxt_ai_default_transcribe_model | default('') }}
NUXT_AI_DEFAULT_TRANSCRIBE_BASE_URL={{ nuxt_ai_default_transcribe_base_url | default('') }}
NUXT_AI_DEFAULT_TRANSCRIBE_API_KEY={{ nuxt_ai_default_transcribe_api_key | default('') }}
NUXT_AI_BYOK_ALLOWED_BASE_URLS={{ nuxt_ai_byok_allowed_base_urls | default('https://api.mistral.ai/v1,https://api.openai.com/v1,https://openrouter.ai/api/v1,https://api.groq.com/openai/v1,https://api.together.xyz/v1,https://api.deepinfra.com/v1/openai,https://api.fireworks.ai/inference/v1,https://api.scaleway.ai/v1') }}
NUXT_AI_BYOK_ALLOW_PRIVATE_URLS={{ nuxt_ai_byok_allow_private_urls | default('false') | string | lower }}
# Global monthly ceiling (USD) on platform-paid AI for all free-tier users.
NUXT_FREE_TIER_TOTAL_BUDGET_USD={{ nuxt_free_tier_total_budget_usd | default('500') }}

# ─── Billing mode ───
# The hosted deployment runs free-only with paid plans "coming soon".
# Flip nuxt_billing_enabled to true (and fill the Stripe vars below) to
# launch paid plans. See shared/config/billingMode.ts.
NUXT_BILLING_ENABLED={{ nuxt_billing_enabled | default('false') | string | lower }}
NUXT_PLANS_COMING_SOON={{ nuxt_plans_coming_soon | default('true') | string | lower }}

# ─── Legal surfaces (hosted: onboarding gate, consent, DPA, /legal/*) ───
NUXT_LEGAL_SURFACES_ENABLED=true

# ─── Product tour (hosted: scroll-driven product page at / for logged-out visitors) ───
NUXT_PRODUCT_TOUR_ENABLED=true

# ─── Stripe billing (only read when NUXT_BILLING_ENABLED is true) ───
NUXT_STRIPE_SECRET_KEY={{ nuxt_stripe_secret_key | default('') }}
NUXT_STRIPE_WEBHOOK_SECRET={{ nuxt_stripe_webhook_secret | default('') }}
NUXT_STRIPE_PRICE_PRO={{ nuxt_stripe_price_pro | default('') }}
NUXT_STRIPE_PRICE_MAX={{ nuxt_stripe_price_max | default('') }}
NUXT_STRIPE_PRICE_ULTRA={{ nuxt_stripe_price_ultra | default('') }}
NUXT_STRIPE_AUTOMATIC_TAX={{ nuxt_stripe_automatic_tax | default('') }}

# ─── Free-tier limit overrides (optional; empty = committed default) ───
# With billing off every account is on the free tier, so these are the
# hosted deployment's effective limits. See shared/config/tiers.ts.
TIER_FREE_LITELLM_BUDGET_USD={{ tier_free_litellm_budget_usd | default('0.5') }}
TIER_FREE_WORKSPACES_OWNED={{ tier_free_workspaces_owned | default('') }}
TIER_FREE_KNOWLEDGE_FILES={{ tier_free_knowledge_files | default('') }}
TIER_FREE_KNOWLEDGE_BYTES_PER_WORKSPACE={{ tier_free_knowledge_bytes_per_workspace | default('') }}
TIER_FREE_KNOWLEDGE_BYTES_PER_USER={{ tier_free_knowledge_bytes_per_user | default('') }}
TIER_FREE_IMAGE_BYTES_PER_USER={{ tier_free_image_bytes_per_user | default('') }}
# Days an unreferenced doc image is kept before the image GC deletes it (0 = off).
NUXT_IMAGE_GC_RETENTION_DAYS={{ nuxt_image_gc_retention_days | default('') }}

# ─── Transactional email (Resend) ───
# Empty RESEND_API_KEY = stub mode (emails logged, not sent). Set both
# for real delivery: the key + a verified-domain From address, e.g.
# `markoto <no-reply@markoto.app>`.
RESEND_API_KEY={{ resend_api_key | default('') }}
NUXT_EMAIL_FROM={{ nuxt_email_from | default('') }}

# ─── OAuth ───
NUXT_OAUTH_GITHUB_CLIENT_ID={{ nuxt_oauth_github_client_id | default('') }}
NUXT_OAUTH_GITHUB_CLIENT_SECRET={{ nuxt_oauth_github_client_secret | default('') }}
NUXT_OAUTH_GOOGLE_CLIENT_ID={{ nuxt_oauth_google_client_id | default('') }}
NUXT_OAUTH_GOOGLE_CLIENT_SECRET={{ nuxt_oauth_google_client_secret | default('') }}

# ─── Sentry ───
NUXT_PUBLIC_SENTRY_DSN={{ nuxt_public_sentry_dsn | default('') }}
SENTRY_DSN={{ sentry_dsn | default('') }}

# ─── Traefik / ACME ───
DOMAIN={{ domain }}
ACME_EMAIL={{ acme_email }}

# ─── Image registry pin ───
REGISTRY={{ registry }}
IMAGE_TAG={{ image_tag }}

# ─── Backup sidecar ───
BACKUP_INTERVAL_SECONDS={{ backup_interval_seconds }}
BACKUP_RETENTION_COUNT={{ backup_retention_count }}
BACKUP_GPG_PASSPHRASE={{ backup_gpg_passphrase }}
BACKUP_S3_ENDPOINT={{ backup_s3_endpoint | default(nuxt_s3_endpoint, true) }}
BACKUP_S3_BUCKET={{ backup_s3_bucket | default(nuxt_s3_bucket, true) }}
BACKUP_S3_ACCESS_KEY={{ backup_s3_access_key | default(nuxt_s3_access_key, true) }}
BACKUP_S3_SECRET_KEY={{ backup_s3_secret_key | default(nuxt_s3_secret_key, true) }}
BACKUP_S3_REGION={{ backup_s3_region | default('us-east-1', true) }}
BACKUP_S3_PREFIX={{ backup_s3_prefix | default('backups/postgres', true) }}

# ─── Postgres TLS ───
# The committed docker-compose.prod.yml runs the in-stack pgvector container
# (POSTGRES_HOST is pinned to `postgres`), which serves no TLS. The app
# defaults to rejectUnauthorized:true in production, so TLS must be explicitly
# disabled or it can't connect. When migrating to OVH Managed PostgreSQL, set
# ovh_pg_host + ovh_pg_ca_remote_path (and drop the compose POSTGRES_HOST
# override) — this then flips to cert-pinned TLS automatically.
{% if ovh_pg_host and ovh_pg_ca_remote_path %}
PGSSLROOTCERT={{ ovh_pg_ca_remote_path }}
PGSSL=
POSTGRES_SSLMODE=require
{% else %}
PGSSLROOTCERT=
PGSSL=disable
POSTGRES_SSLMODE=disable
{% endif %}
