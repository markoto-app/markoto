{
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margin": 20
  },
  "meta": {
    "font": "IBM Plex Sans"
  },
  "body": {
    "font": "IBM Plex Sans",
    "size": 9.5,
    "lineHeight": 1.5,
    "textAlign": "left",
    "color": "#1B2430",
    "background": "#FFFFFF",
    "dropCap": false,
    "firstLineIndent": false,
    "paragraphSpacing": 0.7,
    "hyphenate": false
  },
  "headings": {
    "font": "Source Serif 4",
    "scale": 1.15,
    "weight": 600,
    "underline": false,
    "color": "#12324A",
    "letterSpacing": -0.01,
    "lineHeight": 1.2,
    "spacingScale": 1
  },
  "color": {
    "brand": "#0F5E63",
    "secondary": "#8A96A3"
  },
  "brand": {
    "logoUrl": "",
    "logoHeight": 40
  },
  "layout": {
    "columns": 1,
    "columnGap": 8
  },
  "header": {
    "left": "Quaybridge · Q3 2026 quarterly report",
    "center": "",
    "right": "Confidential",
    "imageUrl": "",
    "imagePosition": "left",
    "imageHeight": 12
  },
  "footer": {
    "left": "Unaudited management accounts",
    "center": "",
    "right": "{page} / {pages}",
    "imageUrl": "",
    "imagePosition": "center",
    "imageHeight": 10
  },
  "code": {
    "theme": "github-light",
    "fontSize": 8.5
  },
  "tables": {
    "headerBackground": "none",
    "headerTextColor": "inherit",
    "borders": "horizontal",
    "zebra": false,
    "cellPadding": 4
  },
  "blocks": {
    "imageRadius": 0,
    "imageMaxWidth": 100,
    "blockquoteStyle": "border",
    "hrStyle": "rule",
    "hrThickness": 1
  },
  "mermaid": {
    "theme": "neutral"
  },
  "alerts": {
    "note": "#2F5B7C",
    "tip": "#3E6B48",
    "important": "#5C4A7A",
    "warning": "#8A6A1F",
    "caution": "#9A2F2A"
  },
  "toc": {
    "maxDepth": 2,
    "showTitle": true,
    "showPageNumbers": true,
    "leaderStyle": "dotted"
  },
  "cover": {
    "enabled": true,
    "layout": "editorial",
    "align": "left",
    "showTitle": true,
    "showSubtitle": true,
    "subtitle": "Quarterly report to shareholders and the supervisory board",
    "showDate": true,
    "showAuthors": true,
    "authors": [
      "Finance & Strategy",
      "Quaybridge Software GmbH, Hamburg"
    ],
    "showLogo": false,
    "titleSize": 2.6,
    "subtitleSize": 1.2
  },
  "customCss": "/* Figures line up in columns. */\n.paged-doc table { font-size: 0.95em; font-variant-numeric: tabular-nums lining-nums; }\n.paged-doc th { vertical-align: bottom; }\n/* Tables with nine or more columns (the five-quarter income statement):\n   smaller type and no wrapped row labels so they fit the text width. */\n.paged-doc table:has(th:nth-child(9)) { font-size: 0.78em; }\n.paged-doc table:has(th:nth-child(9)) th,\n.paged-doc table:has(th:nth-child(9)) td { padding-left: 3px; padding-right: 3px; white-space: nowrap; }\n/* Charts: centred and never taller than a third of the page. */\n.paged-doc .mermaid img { max-height: 90mm; width: auto; margin: 0.6em auto; }\n"
}
