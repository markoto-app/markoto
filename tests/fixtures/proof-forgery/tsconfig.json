  // replaced per test case) against the real proof module.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["probe.ts"]
}
